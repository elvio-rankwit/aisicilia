---
// <head> SEO di ogni pagina: title, description, canonical, robots, Open Graph, Twitter Card, feed RSS, sitemap
// (solo production) e un unico <script type="application/ld+json"> con @graph. Le pagine non scrivono <meta> a mano.
import { IS_BETA, SITE } from '../site';
import { FEEDS, OG, SITEMAP_INDEX_PATH, hreflangLinks } from './config';
import { ymd } from './dates';
import { buildGraph, serializeJsonLd } from './graph';
import type { PageSeo } from './types';
import { abs, normalizePath, ogUrl } from './url';
interface Props { seo: PageSeo }
const { seo } = Astro.props;

const path = normalizePath(seo.path);
const canonical = abs(path);
// La 404 non ha un URL canonico: non va consolidata su se stessa.
const hasCanonical = path !== '/404/';
const robots = IS_BETA ? 'noindex, nofollow' : seo.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const image = ogUrl(path);
const imageAlt = seo.ogTitle ?? seo.title;
const ogType = seo.type ?? 'website';
const isArticle = ogType === 'article';
const alternates = hreflangLinks(path);
const graph = serializeJsonLd(buildGraph(seo));
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
{hasCanonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG.width)} />
<meta property="og:image:height" content={String(OG.height)} />
<meta property="og:image:alt" content={imageAlt} />
{isArticle && seo.publishedAt && <meta property="article:published_time" content={ymd(seo.publishedAt)} />}
{isArticle && seo.modifiedAt && <meta property="article:modified_time" content={ymd(seo.modifiedAt)} />}
{isArticle && <meta property="article:author" content={abs(SITE.author.url)} />}
{ogType === 'profile' && <meta property="profile:first_name" content="Elvio" />}
{ogType === 'profile' && <meta property="profile:last_name" content="Leonardi" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{FEEDS.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={SITE.url + f.path} />)}
{!IS_BETA && <link rel="sitemap" type="application/xml" href={SITE.url + SITEMAP_INDEX_PATH} />}
<script type="application/ld+json" set:html={graph} />
