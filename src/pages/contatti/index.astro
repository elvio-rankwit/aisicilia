---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Prose from '../../components/Prose.astro';
import FormShell from '../../components/FormShell.astro';
import { FORMS } from '../../lib/site';

const m = {
  title: 'Contatti: scrivi ad AI Sicilia',
  description: 'Come contattare il progetto AI Sicilia: email, modulo per i messaggi e le pagine giuste per segnalare un’azienda, un evento o chiedere una rimozione.',
};
---
<BaseLayout seo={{ title: m.title, description: m.description, path: '/contatti/', breadcrumbs: [{ name: 'Contatti', path: '/contatti/' }] }}>
  <PageHead>
    <Fragment slot="eyebrow">Email e moduli</Fragment>
    <Fragment slot="title"><mark class="blk">Contatti</mark></Fragment>
    <p>AI Sicilia è un progetto indipendente gestito da Elvio Leonardi. Per scrivere usa il modulo qui sotto o l’email. Per segnalare un’azienda o un evento, oppure per chiedere una correzione, ci sono due moduli dedicati.</p>
  </PageHead>

  <section aria-labelledby="h-dove">
    <h2 id="h-dove" class="first">Dove trovarci</h2>
    <Prose><dl class="box facts">
      <dt>Email</dt>
      <dd><a href="mailto:info@aisicilia.it">info@aisicilia.it</a></dd>
      <dt>Segnalazioni</dt>
      <dd><a href="/segnala/">Segnala un’azienda o un evento</a></dd>
      <dt>Correzioni</dt>
      <dd><a href="/rimozione/">Richiedi modifica o rimozione</a></dd>
      <dt>Chi c’è dietro</dt>
      <dd><a href="/chi-siamo/">Chi siamo</a></dd>
    </dl></Prose>
  </section>

  <section class="section" aria-labelledby="h-form">
    <h2 id="h-form">Scrivici</h2>
    <FormShell action={FORMS.contatti} envName="PUBLIC_FORM_CONTATTI_URL" submitLabel="Invia il messaggio" label="Modulo di contatto">
      <div class="field">
        <label for="c-nome">Il tuo nome</label>
        <input id="c-nome" name="nome" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="c-email">La tua email</label>
        <input id="c-email" name="email" type="email" required autocomplete="email" />
        <span class="hint">Serve solo per risponderti. Dettagli nell’<a href="/privacy/">informativa privacy</a>.</span>
      </div>
      <div class="field">
        <label for="c-msg">Messaggio</label>
        <textarea id="c-msg" name="messaggio" required></textarea>
      </div>
    </FormShell>
  </section>
</BaseLayout>
<style>
  .first { margin-top: 0; }
  .facts { display: grid; grid-template-columns: 1fr; gap: 4px var(--space-5); max-width: none; }
  .facts dt { margin-top: var(--space-3); }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: 0; font-size: 1.0625rem; }
  @media (min-width: 40rem) { .facts { grid-template-columns: 9rem 1fr; } .facts dt, .facts dt:first-child { margin: 0; padding-top: 4px; } .facts dd { padding-bottom: var(--space-3); } }
</style>
