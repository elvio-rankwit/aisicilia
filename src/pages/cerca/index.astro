---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import SearchForm from '../../components/SearchForm.astro';

const m = {
  title: 'Cerca nel sito: aziende, eventi, guide e prompt',
  description: 'Cerca nelle aziende, negli eventi, nelle guide e nei prompt di AI Sicilia. La ricerca gira nel tuo browser, senza cookie né tracciamento.',
};
---
<BaseLayout seo={{ title: m.title, description: m.description, path: '/cerca/', noindex: true, breadcrumbs: [{ name: 'Cerca', path: '/cerca/' }] }}>
  <PageHead>
    <Fragment slot="eyebrow">Ricerca</Fragment>
    <Fragment slot="title">Cerca nel <mark class="blk">sito</mark></Fragment>
    <p>Aziende, eventi, guide e prompt. Scrivi una parola e premi invio. La ricerca gira nel tuo browser, senza cookie né tracciamento.</p>
  </PageHead>
  <div id="search-box" class="box">
    <SearchForm />
    <noscript><p class="callout warn">La ricerca ha bisogno di JavaScript. Senza, puoi sfogliare le sezioni: <a href="/aziende/">Aziende</a>, <a href="/eventi/">Eventi</a>, <a href="/impara/">Impara</a>, <a href="/prompt/">Prompt</a>.</p></noscript>
  </div>
  <div id="pagefind-ui" class="results"></div>
</BaseLayout>
<style>
  .box { min-height: 7rem; }
  .results { min-height: 4rem; margin-top: var(--space-5); color: var(--ink);
    --pagefind-ui-scale: 1; --pagefind-ui-primary: var(--brand); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--bd); --pagefind-ui-tag: var(--grey-2); --pagefind-ui-border-width: 2px; --pagefind-ui-border-radius: 16px;
    --pagefind-ui-image-border-radius: 8px; --pagefind-ui-font: var(--body); }
  /* Interfaccia Pagefind nei colori v4, anche in scuro (tutto via token) */
  #pagefind-ui.results :global(.pagefind-ui__form) { max-width: 40rem; }
  #pagefind-ui.results :global(.pagefind-ui__search-input) { height: 58px; font: 500 17px var(--body); color: var(--ink); box-shadow: 6px 6px 0 var(--brand); transition: box-shadow var(--ease); }
  #pagefind-ui.results :global(.pagefind-ui__search-input:focus) { box-shadow: 6px 6px 0 var(--or); outline: none; }
  #pagefind-ui.results :global(.pagefind-ui__search-input:focus-visible) { outline: 3px solid var(--brand); outline-offset: 3px; }
  #pagefind-ui.results :global(.pagefind-ui__search-input::placeholder) { color: var(--faint); opacity: 1; }
  #pagefind-ui.results :global(.pagefind-ui__search-clear) { color: var(--brand-d); font: 700 15px var(--body); background: var(--card); border-radius: 10px; min-width: 44px; min-height: 44px; }
  #pagefind-ui.results :global(.pagefind-ui__search-clear:focus-visible) { outline: 3px solid var(--brand); }
  #pagefind-ui.results :global(.pagefind-ui__message) { color: var(--muted); font: 600 16px var(--body); }
  #pagefind-ui.results :global(.pagefind-ui__results) { padding: 0; margin: 0; }
  #pagefind-ui.results :global(.pagefind-ui__result) { max-width: 40rem; margin: 0 0 var(--space-5); padding: 22px 24px 24px; background: var(--card); border: 1.5px solid var(--bd); border-radius: var(--r-lg); box-shadow: 6px 6px 0 var(--grey-2); transition: transform 0.2s, box-shadow 0.2s; }
  #pagefind-ui.results :global(.pagefind-ui__result:last-of-type) { border: 1.5px solid var(--bd); }
  #pagefind-ui.results :global(.pagefind-ui__result:hover) { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--sh); }
  #pagefind-ui.results :global(.pagefind-ui__result-inner) { margin-top: 0; }
  #pagefind-ui.results :global(.pagefind-ui__result-title) { font: 700 18px/1.3 var(--display); letter-spacing: -0.02em; }
  #pagefind-ui.results :global(.pagefind-ui__result-link) { color: var(--ink); text-decoration: none; }
  #pagefind-ui.results :global(.pagefind-ui__result-link:hover) { text-decoration: underline; text-decoration-color: var(--or); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  #pagefind-ui.results :global(.pagefind-ui__result-excerpt) { margin-top: 10px; font: 400 16px/1.6 var(--body); color: var(--muted); }
  #pagefind-ui.results :global(.pagefind-ui__result-excerpt mark) { all: unset; background: var(--or-t); color: var(--or-text); font-weight: 700; border-radius: 4px; padding: 0 3px; }
  #pagefind-ui.results :global(.pagefind-ui__result-tag) { background: var(--grey-2); color: var(--ink); border-radius: 99px; padding: 2px 10px; font-size: 13px; font-weight: 700; }
  #pagefind-ui.results :global(.pagefind-ui__button) { min-height: 48px; padding: 0 26px; background: var(--or); color: var(--on-or); border: 1.5px solid var(--on-or); border-radius: 12px; box-shadow: 3px 3px 0 var(--on-or); font: 800 16px var(--body); }
  #pagefind-ui.results :global(.pagefind-ui__button:hover) { background: var(--or-h); color: var(--on-or); border-color: var(--on-or); }
  #pagefind-ui.results :global(.pagefind-ui__button:focus-visible) { outline: 3px solid var(--brand); outline-offset: 3px; }
</style>
<script>
  // La UI di Pagefind (JS e CSS) si scarica solo qui e solo quando serve: ?q= nell'indirizzo, focus o invio nel campo.
  const form = document.querySelector<HTMLFormElement>('#search-box form');
  const input = form?.querySelector<HTMLInputElement>('input[name="q"]') ?? null;
  const host = document.getElementById('pagefind-ui');
  if (form && input && host) {
    let mounted: Promise<void> | null = null;
    const loadAssets = () =>
      new Promise<void>((resolve, reject) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.append(css);
        const js = document.createElement('script');
        js.src = '/pagefind/pagefind-ui.js';
        js.onload = () => resolve();
        js.onerror = () => reject(new Error('pagefind'));
        document.head.append(js);
      });
    const mount = (q: string) => {
      if (!mounted) {
        mounted = loadAssets().then(() => {
          const PagefindUI = (window as unknown as { PagefindUI: new (o: Record<string, unknown>) => unknown }).PagefindUI;
          new PagefindUI({ element: host, showImages: false, showSubResults: false, resetStyles: false, autofocus: false, translations: { placeholder: 'Cerca nel sito', search_label: 'Cerca nel sito', clear_search: 'Cancella' } });
        });
      }
      return mounted.then(() => {
        const ui = host.querySelector<HTMLInputElement>('input');
        if (ui) {
          ui.setAttribute('aria-label', 'Cerca nel sito');
          if (q && ui.value !== q) { ui.value = q; ui.dispatchEvent(new Event('input', { bubbles: true })); }
          form.hidden = true;
          ui.focus();
        }
      }).catch(() => {
        host.textContent = 'Non riesco a caricare la ricerca. Riprova tra poco, oppure sfoglia le sezioni del sito.';
      });
    };
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { input.value = initial; mount(initial); }
    input.addEventListener('input', () => mount(input.value), { once: true });
    form.addEventListener('submit', (e) => { e.preventDefault(); mount(input.value); });
  }
</script>
