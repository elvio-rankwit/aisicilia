---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DirHero from '../../../components/DirHero.astro';
import SecHead from '../../../components/SecHead.astro';
import Panel from '../../../components/Panel.astro';
import MapPreviewSlot from '../../../components/MapPreviewSlot.astro';
import MapInteractiveSlot from '../../../components/MapInteractiveSlot.astro';
import SourceBox from '../../../components/SourceBox.astro';
import EventCard from '../../../components/EventCard.astro';
import CompanyCard from '../../../components/CompanyCard.astro';
import { getAllEvents, getCompanies, getUpcomingEvents } from '../../../lib/data';
import { relatedEvents } from '../../../lib/related';
import { meta } from '../../../lib/seo/meta';
import { eventNodes } from '../../../lib/seo/jsonld';
import { PROVINCES } from '../../../lib/provinces';
import { RESERVED_SLUGS, cap, countByProvince, joinIt, dateRange, eventPoints, eventStatus, timeRange, weekdayOf } from '../../../components/helpers';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.filter((e) => !RESERVED_SLUGS.includes(e.id)).map((e) => ({ params: { slug: e.id }, props: { id: e.id } }));
}
const all = await getAllEvents();
const e = all.find((x) => x.id === Astro.props.id)!;
const d = e.data;
const prov = PROVINCES[d.province];
const st = eventStatus(e);
const upcoming = await getUpcomingEvents();
const related = relatedEvents(e, upcoming, 3);
const companies = (await getCompanies()).filter((c) => c.data.province === d.province).slice(0, 3);
const time = timeRange(d.start_time, d.end_time);
const hasGeo = d.lat !== undefined && d.lng !== undefined;
const m = meta.event(e);
const path = `/eventi/${e.id}/`;
const canAdd = !st.past && d.status !== 'annullato';
const verb = d.status === 'annullato' ? 'era previsto' : st.past ? 'si è svolto' : d.status === 'rinviato' ? 'era previsto' : 'si svolge';
const formatWhere = d.format === 'online'
  ? 'online'
  : `${d.format === 'ibrido' ? 'in forma ibrida' : 'in presenza'}${d.venue_name ? ` presso ${d.venue_name}` : ''}, a ${d.city}`;
const priceText = d.price === 'gratuito' ? 'L’ingresso è gratuito.' : d.price === 'a pagamento' ? 'L’ingresso è a pagamento.' : 'Il prezzo non è indicato.';
const answer = [
  `Questo evento ${verb} ${d.end_date && d.end_date.getTime() !== d.start_date.getTime() ? 'nelle date' : 'il'} ${dateRange(d.start_date, d.end_date)}${time ? `, ore ${time}` : ''}, ${formatWhere}.`,
  `Lo organizza ${d.organizer} ed è pensato per ${joinIt(d.audience)}; si parla di ${joinIt(d.topics.slice(0, 3))}. ${priceText}`,
].join(' ');
const where = d.format === 'online'
  ? `Online, l’organizzatore è di ${d.city}`
  : [d.venue_name, d.venue_address, d.venue_address?.toLowerCase().includes(d.city.toLowerCase()) ? '' : d.city].filter(Boolean).join(', ');
const dm = new Intl.DateTimeFormat('it-IT', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const dn = new Intl.DateTimeFormat('it-IT', { day: 'numeric', timeZone: 'UTC' });
const multi = !!d.end_date && d.end_date.getTime() !== d.start_date.getTime();
const tileDay = multi ? `${dn.format(d.start_date)}–${dn.format(d.end_date!)}` : dn.format(d.start_date);
const tileMonth = multi && dm.format(d.start_date) !== dm.format(d.end_date!) ? `${dm.format(d.start_date)} – ${dm.format(d.end_date!)}` : dm.format(d.end_date ?? d.start_date);
const arrow = 'M3 8h9m-3.5-4L12.5 8 8.5 12';
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path,
    breadcrumbs: [{ name: 'Eventi', path: '/eventi/' }, { name: prov.name, path: `/eventi/provincia/${d.province}/` }, { name: d.title, path }],
    jsonld: eventNodes(e),
    modifiedAt: d.last_verified,
  }}
>
  <article>
    <DirHero eyebrow={`Evento · ${prov.name}`} tone="teal" compact>
      <Fragment slot="title">{d.title}</Fragment>
      <p><time datetime={d.start_date.toISOString().slice(0, 10)}>{dateRange(d.start_date, d.end_date)}</time>{time && ` · ore ${time}`} · {d.format === 'online' ? 'online' : d.city}</p>
      <ul class="tags"><li><span class={`badge ${st.tone}`}>{st.label}</span></li><li><span class="chip">{cap(d.format)}</span></li><li><span class="chip">{cap(d.price)}</span></li></ul>
      <div slot="after" class="btns">
        <a class="btn p" href={d.event_url} rel="noopener">Pagina dell’evento <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        {canAdd && <a class="btn" href={`/eventi/${e.id}/evento.ics`} download>Aggiungi al calendario</a>}
      </div>
      <Panel slot="side" tone="teal" label="Data dell’evento">
        <p class="tile"><b>{tileDay}</b><small>{tileMonth}</small></p>
        <p class="tmeta">{multi ? 'Più giorni' : weekdayOf(d.start_date)}{time && ` · ore ${time}`}</p>
        <p class="tmeta">{d.format === 'online' ? 'Online' : d.city} ({prov.sigla})</p>
      </Panel>
    </DirHero>

    {st.key === 'concluso' && (
      <div class="callout" role="note">
        <p><strong>Evento concluso.</strong> La scheda resta online come memoria. Gli eventi in programma sono nell’<a href="/eventi/">elenco dei prossimi eventi</a>; quelli già svolti, nell’<a href="/eventi/archivio/">archivio</a>.</p>
      </div>
    )}
    {st.key === 'annullato' && (
      <div class="callout danger" role="note"><p><strong>Evento annullato.</strong> Controlla la pagina dell’organizzatore per eventuali novità. Altri appuntamenti nell’<a href="/eventi/">elenco dei prossimi eventi</a>.</p></div>
    )}
    {st.key === 'rinviato' && (
      <div class="callout warn" role="note"><p><strong>Evento rinviato.</strong> La data indicata qui sotto potrebbe non essere più valida: controlla la pagina dell’organizzatore.</p></div>
    )}
    {st.key === 'spostato' && (
      <div class="callout warn" role="note"><p><strong>Spostato online.</strong> L’evento non si tiene più in presenza: i dettagli sono sulla pagina dell’organizzatore.</p></div>
    )}

    <div class="cols">
      <div class="main">
        <p class="answer">{answer}</p>
        <div class="prose"><p class="desc">{d.description}</p></div>

        <Panel tone="teal" title="Quando, dove, quanto" id="h-dettagli" level={2}>
          <dl class="data">
            <div><dt>Data</dt><dd>{dateRange(d.start_date, d.end_date)}{!d.end_date && ` (${weekdayOf(d.start_date)})`}</dd></div>
            {time && <div><dt>Orario</dt><dd>{time}</dd></div>}
            <div><dt>Formato</dt><dd>{cap(d.format)}</dd></div>
            <div><dt>Prezzo</dt><dd>{cap(d.price)}</dd></div>
            <div class="wide"><dt>Luogo</dt><dd>{where} ({prov.sigla})</dd></div>
            <div class="wide"><dt>Organizzatore</dt><dd>{d.organizer_url ? <a class="ext" href={d.organizer_url} rel="noopener">{d.organizer}</a> : d.organizer}</dd></div>
            <div class="wide"><dt>Per chi</dt><dd>{d.audience.map(cap).join(', ')}</dd></div>
            <div class="wide"><dt>Temi</dt><dd><ul class="tags">{d.topics.map((t) => <li class="chip">{t}</li>)}</ul></dd></div>
          </dl>
        </Panel>
      </div>
      <div class="side">
        <SourceBox urls={[d.source_url]} verified={d.last_verified} what="evento" />
        <p class="rm">Qualcosa è sbagliato o è cambiato? <a href={`/rimozione/?scheda=eventi/${e.id}`}>Richiedi modifica o rimozione di questa scheda</a>.</p>
      </div>
    </div>

    {hasGeo && (
      <section class="section" aria-labelledby="h-mappa">
        <SecHead id="h-mappa" eyebrow="Mappa" title="Dove si svolge" />
        <div class="two">
          <Panel label="Provincia dell’evento"><MapPreviewSlot counts={countByProvince(upcoming)} mode="link" basePath="/eventi/provincia/" active={d.province} label={`${d.title}: provincia di ${prov.name}`} points={[{ lat: d.lat!, lng: d.lng! }]} unit={['evento', 'eventi']} /></Panel>
          <MapInteractiveSlot points={eventPoints([e])} center={[d.lat!, d.lng!]} zoom={14} height={320} label={`Mappa interattiva: ${d.title}`} />
        </div>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="section" aria-labelledby="h-correlati">
      <SecHead id="h-correlati" eyebrow="Nel calendario" title="Altri eventi in programma" />
      <ul class="grid">{related.map((r) => <EventCard event={r} />)}</ul>
    </section>
  )}

  {companies.length > 0 && (
    <section class="section" aria-labelledby="h-aziende">
      <SecHead id="h-aziende" eyebrow="Aziende" title={`Aziende AI di ${prov.name}`}>
        <a slot="more" class="more" href={`/aziende/provincia/${d.province}/`}>Tutte le aziende a {prov.name} <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </SecHead>
      <ul class="grid">{companies.map((c) => <CompanyCard company={c} />)}</ul>
    </section>
  )}
</BaseLayout>
<style>
  .tile { margin: 0; display: flex; flex-direction: column; }
  .tile b { font: 800 clamp(44px, 7vw, 72px)/1 var(--display); letter-spacing: -0.05em; color: var(--teal); white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .tile small { margin-top: 12px; font: 800 14px/1 var(--body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
  .tmeta { margin: 10px 0 0; font-size: 16px; font-weight: 500; text-transform: capitalize; color: var(--muted); }
  .tmeta + .tmeta { margin-top: 2px; }
  .tags { margin-top: 16px; }
  .cols { display: grid; gap: 8px 48px; align-items: start; }
  .main { min-width: 0; }
  .main .answer { margin-bottom: 28px; font-size: 18px; }
  .desc { max-width: 42rem; font-size: 18px; line-height: 1.7; margin-bottom: 36px; }
  .data { display: grid; gap: 22px 32px; margin: 0; max-width: none; }
  .data > div { min-width: 0; }
  .data dt { margin: 0 0 6px; font: 800 12px/1.4 var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .data dd { margin: 0; }
  .side { min-width: 0; }
  .side :global(.source-box) { max-width: none; margin-top: 0; }
  .rm { margin: 0; padding: 0 4px; font-size: 15.5px; color: var(--muted); }
  .two { display: grid; gap: 28px; align-items: start; }
  .callout { margin-bottom: 32px; max-width: 48rem; }
  @media (min-width: 40rem) { .data { grid-template-columns: repeat(2, minmax(0, 1fr)); } .data .wide { grid-column: 1 / -1; } }
  @media (min-width: 62rem) { .cols { grid-template-columns: minmax(0, 1fr) 24rem; } .side { position: sticky; top: 24px; } .two { grid-template-columns: 1fr 1fr; gap: 40px; } }
</style>
