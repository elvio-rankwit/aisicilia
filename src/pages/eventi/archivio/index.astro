---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DirHero from '../../../components/DirHero.astro';
import SecHead from '../../../components/SecHead.astro';
import Panel from '../../../components/Panel.astro';
import EmptyList from '../../../components/EmptyList.astro';
import EventCard from '../../../components/EventCard.astro';
import Pager from '../../../components/Pager.astro';
import CtaSegnala from '../../../components/CtaSegnala.astro';
import { getPastEvents } from '../../../lib/data';
import { meta } from '../../../lib/seo/meta';
import { collectionPageNodes, itemListNodes } from '../../../lib/seo/jsonld';
import { LIST_PAGE_SIZE, PAGINATE_OVER, dateRange } from '../../../components/helpers';

const past = await getPastEvents();
const paginated = past.length > PAGINATE_OVER;
const total = paginated ? Math.ceil(past.length / LIST_PAGE_SIZE) : 1;
const shown = paginated ? past.slice(0, LIST_PAGE_SIZE) : past;
const m = meta.eventsArchive(past.length);
const h1 = 'Archivio degli eventi AI in Sicilia';
const oldest = past[past.length - 1]?.data.start_date;
const newest = past[0]?.data.end_date ?? past[0]?.data.start_date;
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path: '/eventi/archivio/',
    breadcrumbs: [{ name: 'Eventi', path: '/eventi/' }, { name: 'Archivio', path: '/eventi/archivio/' }],
    jsonld: [
      ...collectionPageNodes({ path: '/eventi/archivio/', name: h1, description: m.description }),
      ...itemListNodes({ path: '/eventi/archivio/', name: h1, items: shown.map((e) => ({ url: `/eventi/${e.id}/`, name: e.data.title })) }),
    ],
  }}
>
  <DirHero eyebrow="Eventi già svolti" tone="teal">
    <Fragment slot="title">Archivio degli eventi <mark class="blk">AI</mark> in Sicilia</Fragment>
    {past.length > 0 && oldest ? (
      <>
        <p><b>{past.length} {past.length === 1 ? 'evento già svolto' : 'eventi già svolti'}</b> in Sicilia, dal più recente al più vecchio (il più vecchio è del {dateRange(oldest)}).</p>
        <p>Le schede restano online per consultare date, luoghi e organizzatori. Cerchi quello che deve ancora arrivare? Vai ai <a href="/eventi/">prossimi eventi</a>.</p>
      </>
    ) : (
      <>
        <p>L’archivio è vuoto: nessun evento è ancora concluso.</p>
        <p>Gli eventi passati finiscono qui in automatico. Guarda i <a href="/eventi/">prossimi eventi</a>.</p>
      </>
    )}
    <Fragment slot="side">
      <Panel tone="teal" label="Riepilogo dell’archivio">
        <p class="k">In archivio</p>
        <p class="v">{past.length}</p>
        <p class="d">{past.length > 0 && oldest && newest ? <>{past.length === 1 ? 'evento concluso' : 'eventi conclusi'}, tra il {dateRange(oldest)} e il {dateRange(newest)}.</> : 'Nessun evento concluso, per ora.'}</p>
        <a class="more" href="/eventi/">Vai ai prossimi eventi <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9m-3.5-4L12.5 8 8.5 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </Panel>
    </Fragment>
  </DirHero>
  <section class="section" aria-labelledby="h-archivio">
    <SecHead id="h-archivio" eyebrow="Archivio" title="Eventi passati" sub={shown.length > 0 ? 'I più recenti per primi.' : undefined} />
    {shown.length > 0 ? (
      <>
        <ul class="grid">{shown.map((e) => <EventCard event={e} />)}</ul>
        <Pager base="/eventi/archivio/" current={1} total={total} />
      </>
    ) : (
      <EmptyList title="Nessun evento concluso, per ora">
        <p>Quando un evento finisce, la sua scheda resta qui come memoria. Per il momento ci sono solo appuntamenti ancora da venire.</p>
        <Fragment slot="actions"><a class="btn p" href="/eventi/">Guarda i prossimi eventi</a></Fragment>
      </EmptyList>
    )}
  </section>
  <CtaSegnala text="Ti risulta un evento passato che manca? Segnalalo con il link alla pagina originale." label="Segnala un evento" />
</BaseLayout>
<style>
  .k { margin: 0 0 10px; font: 800 12px/1 var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .v { margin: 0; font: 800 clamp(56px, 9vw, 96px)/1 var(--display); letter-spacing: -0.05em; font-variant-numeric: tabular-nums lining-nums; color: var(--teal); }
  .d { margin: 14px 0 18px; max-width: 32ch; color: var(--muted); }
</style>
