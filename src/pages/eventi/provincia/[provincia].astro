---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPreviewSlot from '../../../components/MapPreviewSlot.astro';
import MapInteractiveSlot from '../../../components/MapInteractiveSlot.astro';
import EventCard from '../../../components/EventCard.astro';
import CompanyCard from '../../../components/CompanyCard.astro';
import DirHero from '../../../components/DirHero.astro';
import SecHead from '../../../components/SecHead.astro';
import EmptyList from '../../../components/EmptyList.astro';
import OtherProvinces from '../../../components/OtherProvinces.astro';
import CtaSegnala from '../../../components/CtaSegnala.astro';
import { eventPath, getAllEvents, getCompanies, getUpcomingEvents } from '../../../lib/data';
import { meta } from '../../../lib/seo/meta';
import { collectionPageNodes, itemListNodes } from '../../../lib/seo/jsonld';
import { PROVINCES, PROVINCE_SLUGS, type ProvinceSlug } from '../../../lib/provinces';
import { countByProvince, dateRange, eventPoints, isScheduled, joinIt, plural } from '../../../components/helpers';

export function getStaticPaths() {
  return PROVINCE_SLUGS.map((provincia) => ({ params: { provincia } }));
}
const slug = Astro.params.provincia as ProvinceSlug;
const prov = PROVINCES[slug];
const [upcoming, allCompanies, anyEvents] = await Promise.all([getUpcomingEvents(), getCompanies(), getAllEvents()]);
const events = upcoming.filter((e) => e.data.province === slug);
const scheduled = events.filter(isScheduled);
const companies = allCompanies.filter((c) => c.data.province === slug);
const counts = countByProvince(upcoming);
const points = eventPoints(events);
const m = meta.eventsProvince(slug, scheduled.length);
const path = `/eventi/provincia/${slug}/`;
const h1 = `Eventi AI in provincia di ${prov.name}`;
const first = events[0]?.data.start_date;
const nOthers = PROVINCE_SLUGS.filter((p) => p !== slug && counts[p] > 0).sort((a, b) => counts[b] - counts[a]).slice(0, 3);
const arrow = 'M3 8h9m-3.5-4L12.5 8 8.5 12';
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path,
    noindex: events.length === 0 && !anyEvents.some((e) => e.data.province === slug) && !allCompanies.some((c) => c.data.province === slug),
    breadcrumbs: [{ name: 'Eventi', path: '/eventi/' }, { name: prov.name, path }],
    jsonld: [
      ...collectionPageNodes({ path, name: h1, description: m.description }),
      ...itemListNodes({ path, name: h1, items: events.map((e) => ({ url: eventPath(e), name: e.data.title })) }),
    ],
  }}
>
  <DirHero eyebrow={`Provincia · ${prov.ente}`} tone="teal">
    <Fragment slot="title">Eventi <mark class="blk">AI</mark> in provincia di {prov.name}</Fragment>
    {events.length > 0 && first ? (
      <>
        <p>In provincia di {prov.name} {scheduled.length === 1 ? 'c’è' : 'ci sono'} <b>{plural(scheduled.length, 'evento in programma', 'eventi in programma')}</b> sull’intelligenza artificiale, il primo il {dateRange(first)}.</p>
        <p>Su tutta la Sicilia sono {upcoming.filter(isScheduled).length}.</p>
      </>
    ) : (
      <>
        <p>Nessun evento in programma a {prov.name}, per ora.</p>
        <p>Ne conosci uno? <a href="/segnala/">Segnalalo</a>: lo controlliamo sulla pagina dell’organizzatore.</p>
      </>
    )}
    <dl slot="after" class="figs">
      <div><dt>in programma</dt><dd>{scheduled.length}</dd></div>
      <div><dt>aziende in zona</dt><dd>{companies.length}</dd></div>
      <div><dt>in tutta la Sicilia</dt><dd>{upcoming.filter(isScheduled).length}</dd></div>
    </dl>
    <Fragment slot="side">
      <MapPreviewSlot variant="hero" counts={counts} mode="link" basePath="/eventi/provincia/" active={slug} label={`Eventi AI in provincia di ${prov.name}, evidenziata sulla mappa della Sicilia`} unit={['evento', 'eventi']} points={points} />
      <ul class="legend" aria-label="Legenda della mappa">
        <li><i class="e"></i>Evento con un luogo</li>
        <li><i class="t"></i>Più eventi, blu più scuro</li>
      </ul>
    </Fragment>
  </DirHero>

  <section class="section" aria-labelledby="h-elenco">
    <SecHead id="h-elenco" eyebrow="Calendario" title={`Prossimi eventi a ${prov.name}`}>
      <a slot="more" class="more" href="/eventi/">Tutta la Sicilia <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </SecHead>
    {events.length > 0 ? (
      <ul class="grid">{events.map((e) => <EventCard event={e} />)}</ul>
    ) : (
      <EmptyList title={`Nessun evento a ${prov.name}, per ora`}>
        <p>Qui non c’è ancora nessuna data pubblicata.{nOthers.length > 0 && <> Le province con più eventi sono {joinIt(nOthers.map((p) => `${PROVINCES[p].name} (${counts[p]})`))}.</>} Ne conosci uno qui? Mandaci il link.</p>
        <Fragment slot="actions"><a class="btn p" href="/segnala/">Segnala un evento</a><a class="btn" href="/eventi/">Calendario completo</a></Fragment>
      </EmptyList>
    )}
  </section>

  {points.length > 0 && (
    <section class="section" aria-labelledby="h-mappa">
      <SecHead id="h-mappa" eyebrow="Mappa" title="Sulla mappa" sub="Compaiono gli eventi con un luogo. Quelli online non hanno un punto sulla mappa: li trovi nell’elenco." />
      <MapInteractiveSlot auto points={points} center={prov.center} zoom={prov.zoom} label={`Mappa degli eventi AI in provincia di ${prov.name}`} />
    </section>
  )}

  <section class="section" aria-labelledby="h-aziende">
    <SecHead id="h-aziende" eyebrow="Aziende" title={`Aziende AI di ${prov.name}`}>
      <a slot="more" class="more" href={`/aziende/provincia/${slug}/`}>Tutte le aziende a {prov.name} <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </SecHead>
    {companies.length > 0 ? (
      <ul class="grid">{companies.slice(0, 3).map((c) => <CompanyCard company={c} />)}</ul>
    ) : (
      <EmptyList title={`Nessuna azienda a ${prov.name}, per ora`}>
        <p>Non abbiamo ancora un’azienda verificata in questa provincia. Ne conosci una? Mandaci il link al sito.</p>
        <Fragment slot="actions"><a class="btn p" href="/segnala/">Segnala un’azienda</a><a class="btn" href="/aziende/">Tutte le aziende</a></Fragment>
      </EmptyList>
    )}
  </section>

  <OtherProvinces current={slug} counts={counts} basePath="/eventi/provincia/" label="Eventi nelle altre province" tone="teal" />
  <CtaSegnala text="Conosci un evento sull’AI in Sicilia? Segnalalo: lo controlliamo e lo aggiungiamo." label="Segnala un evento" />
</BaseLayout>
