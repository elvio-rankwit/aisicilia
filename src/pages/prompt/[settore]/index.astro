---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import PromptCard from '../../../components/PromptCard.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { formatDate, getArticles, getPromptsBySector, latestDate } from '../../../lib/data';
import { articlesForSector } from '../../../lib/related';
import { meta } from '../../../lib/seo/meta';
import { collectionPageNodes, itemListNodes } from '../../../lib/seo/jsonld';
import { PROMPT_SECTORS, PROMPT_SECTOR_SLUGS, type PromptSector } from '../../../lib/taxonomies';
import { plural } from '../../../components/helpers';

export function getStaticPaths() {
  return PROMPT_SECTOR_SLUGS.map((settore) => ({ params: { settore } }));
}
const sector = Astro.params.settore as PromptSector;
const label = PROMPT_SECTORS[sector];
const prompts = await getPromptsBySector(sector);
const articles = articlesForSector(sector, await getArticles(), 3);
const m = meta.promptSector(sector, prompts.length);
const updated = latestDate(prompts.map((p) => p.data.tested_at));
const path = `/prompt/${sector}/`;
const h1 = `Prompt AI per ${label.toLowerCase()}`;
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path, modifiedAt: updated,
    breadcrumbs: [{ name: 'Prompt', path: '/prompt/' }, { name: label, path }],
    jsonld: [
      ...collectionPageNodes({ path, name: h1, description: m.description }),
      ...itemListNodes({ path, name: h1, items: prompts.map((p) => ({ url: `/prompt/${sector}/${p.id}/`, name: p.data.title })) }),
    ],
  }}
>
  <PageHead>
    <Fragment slot="eyebrow"><a href="/prompt/">Libreria prompt</a> · {label}</Fragment>
    <Fragment slot="title">Prompt <mark class="blk">AI</mark> per {label.toLowerCase()}</Fragment>
    {prompts.length > 0 ? (
      <p>{plural(prompts.length, 'prompt pronto', 'prompt pronti')} per {label.toLowerCase()}. Ognuno dice a cosa serve, che livello richiede, quali variabili compilare e dove può sbagliare. Copia, sostituisci i dati tra graffe e rileggi sempre il risultato prima di usarlo.</p>
    ) : (
      <p>I prompt per {label.toLowerCase()} sono in preparazione. Ognuno viene provato prima di essere pubblicato.</p>
    )}
    {updated && <p slot="meta" class="upd">Ultimo test: <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time></p>}
  </PageHead>

  <section class="section" aria-labelledby="h-prompt">
    <h2 id="h-prompt" class="first">I prompt per {label.toLowerCase()}</h2>
    {prompts.length > 0 ? (
      <ul class="grid">{prompts.map((p) => <PromptCard prompt={p} />)}</ul>
    ) : (
      <EmptyState text="Nessun prompt pubblicato in questo settore per ora." cta={false} />
    )}
  </section>

  {articles.length > 0 && (
    <section class="section" aria-labelledby="h-guide">
      <div class="section-head">
        <h2 id="h-guide">Guide collegate</h2>
        <a href="/impara/">Tutte le guide</a>
      </div>
      <ul class="grid">{articles.map((a) => <ArticleCard article={a} />)}</ul>
    </section>
  )}

  <p class="section"><a class="more" href="/prompt/">Tutti i settori della libreria <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9m-3.5-4L12.5 8 8.5 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
</BaseLayout>
<style>
  .first { margin-top: 0; }
  .upd { margin: var(--space-4) 0 0; font-size: 15px; color: var(--muted); }
</style>
