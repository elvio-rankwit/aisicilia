---
// Home v4: riproduce docs/mockups/hp-c-finale.html con dati reali (solo da src/lib/data.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import MapPreviewSlot from '../components/MapPreviewSlot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaSegnala from '../components/CtaSegnala.astro';
import SearchForm from '../components/SearchForm.astro';
import { formatDate, getArticles, getCompanies, getPrompts, getUpcomingEvents, latestDate, today } from '../lib/data';
import { PROVINCES, PROVINCE_SLUGS, type ProvinceSlug } from '../lib/provinces';
import { PROMPT_SECTORS } from '../lib/taxonomies';
import { meta } from '../lib/seo/meta';
import { cap, clip, countByProvince, joinIt } from '../components/helpers';

const [companies, events, articles, prompts] = await Promise.all([getCompanies(), getUpcomingEvents(), getArticles(), getPrompts()]);
const m = meta.home();
const t0 = today().getTime();
const lastDay = (e: (typeof events)[number]) => (e.data.end_date ?? e.data.start_date).getTime();
const isToday = (e: (typeof events)[number]) => e.data.start_date.getTime() <= t0 && t0 <= lastDay(e);

// Conteggi
const counts = countByProvince(companies);
const evCounts = countByProvince(events);
const nC = companies.length;
const nE = events.length;
const sorted = [...PROVINCE_SLUGS].sort((a, b) => counts[b] - counts[a] || PROVINCES[a].name.localeCompare(PROVINCES[b].name, 'it'));
const withData = sorted.filter((p) => counts[p] > 0);
const zeros = sorted.filter((p) => counts[p] === 0);
const maxC = Math.max(1, ...withData.map((p) => counts[p]));
const names = (list: ProvinceSlug[]) => joinIt(list.map((p) => PROVINCES[p].name));
const inCity = (name: string) => (/^[AE]/.test(name) ? 'ad' : 'a') + ' ' + name;
const noun = (n: number, one: string, many: string) => (n === 1 ? one : many);

// Date
const dm = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const mon = new Intl.DateTimeFormat('it-IT', { month: 'short', timeZone: 'UTC' });
const day = new Intl.DateTimeFormat('it-IT', { day: 'numeric', timeZone: 'UTC' });
const words = ['nessuno', 'uno', 'due', 'tre', 'quattro', 'cinque', 'sei', 'sette', 'otto', 'nove', 'dieci'];
const updated = latestDate([...companies.map((c) => c.data.last_verified), ...events.map((e) => e.data.last_verified)]);
const eventsEnd = events.length ? new Date(Math.max(...events.map(lastDay))) : undefined;
const nToday = events.filter(isToday).length;

// Hero
const featured = companies.find((c) => c.data.featured);
const mapEvents = events.filter((e) => e.data.lat !== undefined && e.data.lng !== undefined).map((e) => ({ lat: e.data.lat!, lng: e.data.lng!, today: isToday(e) }));

// Barra dei numeri
const nStartup = companies.filter((c) => c.data.type === 'startup').length;
const nRicerca = companies.filter((c) => c.data.type === 'centro di ricerca').length;
const nOther = nC - nStartup - nRicerca;
const companiesText = nStartup && nRicerca
  ? `${nStartup} ${noun(nStartup, 'startup', 'startup')}, ${nRicerca} ${noun(nRicerca, 'centro di ricerca', 'centri di ricerca')}` + (nOther ? ` e ${nOther} ${noun(nOther, 'altra realtà', 'altre realtà')}.` : '.')
  : 'Realtà siciliane con l’AI al centro del prodotto o del servizio.';
const evProv = [...PROVINCE_SLUGS].filter((p) => evCounts[p] > 0).sort((a, b) => evCounts[b] - evCounts[a] || PROVINCES[a].name.localeCompare(PROVINCES[b].name, 'it')).slice(0, 3);
const eventsText = nE
  ? `Da oggi al ${dm.format(eventsEnd!)}. ` + joinIt(evProv.map((p) => `${evCounts[p]} ${inCity(PROVINCES[p].name)}`)) + '.'
  : 'Nessun evento in programma per ora.';
const times = articles.map((a) => a.data.reading_time);
const guidesText = articles.length ? `Per chi ha un’attività. Da ${Math.min(...times)} a ${Math.max(...times)} minuti di lettura.` : 'Le prime guide per le imprese sono in preparazione.';
const noCompanyProvinces = zeros.length;
const nSectors = new Set(prompts.map((p) => p.data.sector)).size;
const promptsText = prompts.length ? `Da incollare e adattare, in ${nSectors} settori. Ognuno dice dove sbaglia.` : 'La libreria di prompt è in preparazione.';
const stats = [
  { href: '/aziende/', label: 'Aziende', n: nC, text: companiesText },
  { href: '/eventi/', label: 'Eventi in programma', n: nE, text: eventsText },
  { href: '/impara/', label: 'Guide', n: articles.length, text: guidesText },
  { href: '/prompt/', label: 'Prompt', n: prompts.length, text: promptsText },
];

// Sezione aziende
const top2 = withData.slice(0, 2);
const top2Sum = top2.reduce((s, p) => s + counts[p], 0);
const companiesSub = nC
  ? (top2.length === 2 ? `${names(top2)} hanno ${top2Sum} schede su ${nC}. ` : '') + (noCompanyProvinces ? `${names(zeros)} non ne hanno ancora.` : '')
  : 'La directory è in costruzione.';
// Testo di presentazione scelto dalla redazione per la scheda in evidenza; in mancanza, un estratto della descrizione.
const TEASER: Record<string, string> = {
  rankwit: 'Ogni giorno fa le domande dei viaggiatori a ChatGPT, Gemini, Claude, Perplexity e AI Overview. Poi conta quante volte compare ogni hotel o destinazione, rispetto ai concorrenti, e da quali fonti arrivano le risposte.',
};
const fd = featured?.data;
// Senza schede in evidenza, la colonna mostra le ultime realtà verificate (più recenti prima).
const latest = [...companies]
  .sort((a, b) => b.data.last_verified.getTime() - a.data.last_verified.getTime() || a.data.name.localeCompare(b.data.name, 'it'))
  .slice(0, 5);

// Eventi
const timeOf = (e: (typeof events)[number]) => e.data.start_time ?? '';
const rows = [...events].sort((a, b) => a.data.start_date.getTime() - b.data.start_date.getTime() || timeOf(a).localeCompare(timeOf(b))).slice(0, 6);
const dateParts = (e: (typeof events)[number]) => {
  const s = e.data.start_date;
  const en = e.data.end_date;
  if (!en || en.getTime() === s.getTime()) return { d: day.format(s), m: mon.format(s) };
  const sameMonth = mon.format(s) === mon.format(en) && s.getUTCFullYear() === en.getUTCFullYear();
  return { d: `${day.format(s)}–${day.format(en)}`, m: sameMonth ? mon.format(s) : `${mon.format(s)}–${mon.format(en)}` };
};
const price = (p: string) => (p === 'non indicato' ? 'Prezzo non indicato' : cap(p));
const eventsSub = nE
  ? (nToday ? `${cap(words[nToday] ?? String(nToday))} ${nToday === 1 ? 'si tiene' : 'si tengono'} oggi. Gli altri arrivano fino al ${dm.format(eventsEnd!)}.` : `Dal ${dm.format(events[0].data.start_date)} al ${dm.format(eventsEnd!)}.`)
  : 'Nessun evento in programma per ora. Ne conosci uno? Segnalalo.';

// Guide: tre scelte dalla redazione (la prima in grande), poi le più recenti se mancano
const GUIDES = ['incentivi-finanziamenti-digitalizzazione-ai-sicilia', 'ai-pmi-siciliane-da-dove-cominciare', 'ai-hotel-bb-strutture-ricettive'];
const picked = GUIDES.map((id) => articles.find((a) => a.id === id)).filter((a): a is NonNullable<typeof a> => !!a);
const guides = [...picked, ...[...articles].sort((a, b) => b.data.updated_at.getTime() - a.data.updated_at.getTime()).filter((a) => !picked.includes(a))].slice(0, 3);

// Prompt in vetrina
const PROMPT = 'risposta-recensione-negativa-booking-ospitalita';
const showcase = prompts.find((p) => p.id === PROMPT) ?? prompts[0];
const pd = showcase?.data;
const firstSentence = (s: string) => s.match(/^.+?[.!?](\s|$)/)?.[0].trim() ?? s;
const warn = showcase ? (showcase.id === PROMPT ? 'Non incollare nome, cognome, email o dati di prenotazione dell’ospite. Nel test l’AI ha aggiunto una circostanza che non era tra i fatti: ora il prompt lo vieta.' : firstSentence(pd!.limits_and_warnings)) : '';
const excerpt = pd ? pd.prompt_text.split('\n\n').slice(0, 3).join('\n\n') : '';
const parts = excerpt.split(/(\{[a-z0-9_]+\})/g);

// Fiducia
const nAddress = companies.filter((c) => c.data.geo_precision === 'indirizzo').length;
const arrow = 'M3 8h9m-3.5-4L12.5 8 8.5 12';
---
<BaseLayout seo={{ title: m.title, description: m.description, path: '/' }}>
  <section slot="hero" class="hero" aria-labelledby="h-hero">
    <div class="container">
      <div class="hero-copy">
        <p class="eyebrow">Mappa aggiornata al {updated ? formatDate(updated) : formatDate(new Date())}</p>
        <h1 id="h-hero">Dove si fa <mark class="blk">AI</mark> in Sicilia</h1>
        <p class="lead"><b>{nC} {noun(nC, 'azienda', 'aziende')}</b> e <b>{nE} {noun(nE, 'evento', 'eventi')}</b> in programma, ognuno con le sue fonti. Cerca per nome, tema o provincia.</p>
        <SearchForm large id="q-home" label="Cerca nel portale" placeholder="Un’azienda, un tema, una provincia" />
        <p class="hero-note">{nC ? <>Sulla mappa le aziende sono in <b>{withData.length} province su 9</b>.{noCompanyProvinces > 0 && <> {names(zeros)} {noCompanyProvinces === 1 ? 'è ancora vuota' : 'sono ancora vuote'}.</>}</> : 'La directory è in costruzione: le prime schede arrivano a breve.'}</p>
        <div class="legend" role="group" aria-label="Legenda della mappa">
          <span><i class="a"></i>Azienda</span><span><i class="e"></i>Evento in programma</span>{featured && <span><i class="r"></i>In evidenza</span>}
        </div>
      </div>
    </div>
    <div class="hero-map">
      <MapPreviewSlot variant="hero" counts={counts} eventCounts={evCounts} mode="link" basePath="/aziende/provincia/" label={`Mappa della Sicilia con ${nC} aziende e ${nE} eventi in programma, divisi per provincia`}
        points={companies.map((c) => ({ lat: c.data.lat, lng: c.data.lng }))} events={mapEvents} featured={fd ? { lat: fd.lat, lng: fd.lng, name: fd.name } : undefined} />
      <div class="readout" id="ro" aria-live="polite">
        <div class="k">Provincia</div>
        <div class="v" id="rov">Tutta la Sicilia</div>
        <div class="d" id="rod"><b>{nC}</b> {noun(nC, 'azienda', 'aziende')}, <u>{nE}</u> {noun(nE, 'evento', 'eventi')} in programma. Passa su una provincia.</div>
      </div>
    </div>
  </section>

  <div slot="hero" class="stats">
    <div class="container">
      <ul>
        {stats.map((s) => (
          <li class="stat">
            <a href={s.href} data-astro-prefetch>
              <span class="top-r">{s.label} <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <b>{s.n}</b>
              <p>{s.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <section slot="hero" class="s" id="aziende" aria-labelledby="h-az">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">Aziende</p><h2 id="h-az">Aziende per provincia</h2>{companiesSub && <p class="sub">{companiesSub}</p>}</div>
        <a class="more" href="/aziende/" data-astro-prefetch>Tutte le {nC} aziende <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
      <div class="grid2">
        <div class="card pcard">
          <ul class="plist" aria-label="Aziende ed eventi per provincia">
            {withData.map((p) => (
              <li class="prow">
                <span class="pn"><abbr title={PROVINCES[p].name}>{PROVINCES[p].sigla}</abbr> <a href={`/aziende/provincia/${p}/`}>{PROVINCES[p].name}</a></span>
                <progress class="bar" max="100" value={Math.round((counts[p] / maxC) * 1000) / 10} aria-hidden="true"></progress>
                <span class="num">{counts[p]}</span>
                <span class="pe">{evCounts[p]} {noun(evCounts[p], 'evento', 'eventi')}</span>
              </li>
            ))}
            {zeros.length > 0 && (
              <li class="zeros">
                <span class="zl">Ancora a zero</span>
                <span class="zc">{zeros.map((p) => <span class="chip"><abbr title={PROVINCES[p].name}>{PROVINCES[p].sigla}</abbr> {PROVINCES[p].name}</span>)}</span>
                <span class="zt">Nessuna scheda. Ne conosci una? <a href="/segnala/">Segnalala.</a></span>
              </li>
            )}
          </ul>
        </div>
        {featured && fd && (
          <article class="feat" aria-labelledby="h-rw">
            <span class="tag">In evidenza</span>
            <h3 id="h-rw">{fd.name}</h3>
            <p class="where">{fd.city}, provincia di {PROVINCES[fd.province].name} · {fd.type}</p>
            <p class="t">{TEASER[featured.id] ?? clip(fd.description, 260)}</p>
            <div class="pills">{[...fd.ai_areas, ...fd.sectors_served].slice(0, 3).map((a) => <span class="pill">{cap(a)}</span>)}</div>
            {fd.disclosure && <p class="note">{fd.disclosure}</p>}
            <div class="foot"><span>Verificata il {formatDate(fd.last_verified)}</span><a class="btn" href={`/aziende/${featured.id}/`} data-astro-prefetch>Apri la scheda <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
          </article>
        )}
        {!featured && latest.length > 0 && (
          <div class="card lcard" aria-labelledby="h-latest">
            <p class="eyebrow">Ultime verifiche</p>
            <h3 id="h-latest">Appena controllate</h3>
            <ul class="llist">
              {latest.map((c) => (
                <li>
                  <a href={`/aziende/${c.id}/`} data-astro-prefetch>
                    <span class="ln">{c.data.name}</span>
                    <span class="lm">{c.data.city} · {c.data.type} · {formatDate(c.data.last_verified)}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="more" href="/aziende/" data-astro-prefetch>Sfoglia tutte le schede <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section slot="hero" class="s alt" id="eventi" aria-labelledby="h-ev">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">Eventi</p><h2 id="h-ev">Prossimi eventi</h2><p class="sub">{eventsSub}</p></div>
        <a class="more" href="/eventi/" data-astro-prefetch>Tutti i {nE} eventi <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
      {rows.length > 0 && (
        <ol class="evl">
          {rows.map((e) => {
            const dp = dateParts(e);
            const place = e.data.format === 'online' ? `Online, organizza ${e.data.city}` : e.data.city;
            const when = e.data.start_time ? `ore ${e.data.start_time}` : e.data.end_date && e.data.end_date.getTime() !== e.data.start_date.getTime() ? 'più giorni' : '';
            return (
              <li class="ev-row">
                <a href={`/eventi/${e.id}/`} data-astro-prefetch>
                  <span class="date"><b>{dp.d}</b><small>{dp.m}</small></span>
                  <span class="evmain"><span class="evt">{e.data.title}</span><span class="evm">{[place, e.data.format, when].filter(Boolean).join(' · ')}</span></span>
                  <span class="chips">{isToday(e) && <span class="chip today">Oggi</span>}<span class="chip pv">{PROVINCES[e.data.province].sigla}</span><span class="chip">{price(e.data.price)}</span></span>
                </a>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>

  <section slot="hero" class="s" id="guide" aria-labelledby="h-gu">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">Guide</p><h2 id="h-gu">Guide per chi ha un’attività</h2><p class="sub">Scritte da Elvio Leonardi, con fonti ufficiali e la data dell’ultimo aggiornamento.</p></div>
        <a class="more" href="/impara/" data-astro-prefetch>Tutte le {articles.length} guide <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
      {guides.length > 0 && <ul class="guides">{guides.map((a, i) => <ArticleCard article={a} big={i === 0} />)}</ul>}
    </div>
  </section>

  {showcase && pd && (
    <section slot="hero" class="s alt" id="prompt" aria-labelledby="h-pr">
      <div class="container">
        <div class="pgrid">
          <div>
            <p class="eyebrow">Prompt in vetrina</p>
            <h2 id="h-pr">{pd.title}</h2>
            <p class="goal">{pd.goal}</p>
            <p class="warn">{warn}</p>
            <div class="pmeta"><span class="pill">{PROMPT_SECTORS[pd.sector]}</span><span class="pill">{cap(pd.use_case)}</span><span class="pill">Livello {pd.level}</span><span class="pill">Testato il {formatDate(pd.tested_at)}</span></div>
            <p class="plink"><a class="more" href="/prompt/" data-astro-prefetch>Altri {prompts.length - 1} prompt <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a></p>
          </div>
          <div class="code" role="group" aria-label="Testo del prompt">
            <div class="bar2">
              <span>PROMPT · {pd.variables.length} {noun(pd.variables.length, 'variabile', 'variabili')}</span>
              <button class="copy js-only inline" id="cp" type="button" data-text={pd.prompt_text}><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3 10.5V4a1 1 0 0 1 1-1h6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg><span id="cpt" aria-live="polite">Copia</span></button>
            </div>
            <pre>{parts.map((s, i) => (i % 2 ? <mark>{s}</mark> : s))}</pre>
            <div class="fade"></div>
            <p class="more-l">Il testo completo è <a href={`/prompt/${pd.sector}/${showcase.id}/`}>nella scheda</a>.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <section slot="hero" class="s" id="fiducia" aria-labelledby="h-fi">
    <div class="container">
      <div class="head">
        <div><p class="eyebrow">Fiducia</p><h2 id="h-fi">Come verifichiamo i dati</h2><p class="sub">Una scheda va online solo se ogni dato risulta da una fonte che abbiamo aperto e letto.</p></div>
        <a class="more" href="/metodologia/" data-astro-prefetch>Leggi la metodologia <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
      <ol class="steps">
        <li class="step"><i>01</i><h3>Fonte aperta</h3><p>Sito ufficiale, registro pubblico, pagina dell’organizzatore. LinkedIn, Crunchbase e i siti che vietano di leggerli restano fuori.</p></li>
        <li class="step"><i>02</i><h3>Testi riscritti</h3><p>Le descrizioni sono scritte da zero. Niente loghi di terzi, <b>nessun dato personale</b>: solo informazioni di imprese.</p></li>
        <li class="step"><i>03</i><h3>Data di controllo</h3><p>Ogni scheda dice quando l’abbiamo verificata.{updated && <> Le ultime sono del <b>{formatDate(updated)}</b>.</>}</p></li>
        <li class="step"><i>04</i><h3>Punto sulla mappa</h3><p>Con un indirizzo, il punto è lì: succede per <b>{nAddress} {noun(nAddress, 'azienda', 'aziende')} su {nC}</b>. Senza, è il centro del comune e lo scriviamo.</p></li>
      </ol>
      <div class="trust-foot"><p>Per cercare e preparare le bozze usiamo agenti AI. Verifica delle fonti e responsabilità di ciò che si pubblica restano a una persona.</p><a class="btn" href="/rimozione/" data-astro-prefetch>Chiedi una modifica o la rimozione</a></div>
    </div>
  </section>

  <CtaSegnala slot="hero" variant="band" />
</BaseLayout>
<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; background-color: var(--bg); background-image: radial-gradient(circle at 1px 1px, var(--dot) 1.2px, transparent 0); background-size: 24px 24px; display: flex; flex-direction: column; padding-bottom: 40px; }
  .hero > .container, .hero-copy { display: contents; }
  .hero-copy > :global(*) { position: relative; z-index: 2; margin-inline: 20px; }
  .hero-copy .eyebrow { order: 1; margin-top: 34px; margin-bottom: 0; }
  h1 { order: 2; margin: 18px 20px; font-size: clamp(30px, 11.4vw, 50px); line-height: 1.1; letter-spacing: -0.05em; font-weight: 800; text-wrap: balance; }
  .lead { order: 3; margin-bottom: 0; max-width: 32ch; font-size: 19px; font-weight: 500; line-height: 1.5; color: var(--ink); }
  .lead b { font-weight: 800; background: linear-gradient(transparent 62%, color-mix(in srgb, var(--or) 38%, transparent) 62%); }
  .hero-map { order: 4; position: relative; z-index: 1; margin: -34px 16px -6px -8px; }
  .hero :global(.search) { order: 5; margin-right: 25px; }
  .hero-note { order: 6; margin-top: 20px; margin-bottom: 0; max-width: 46ch; font-size: 16px; color: var(--muted); }
  .hero-note b { color: var(--ink); font-weight: 700; }
  .legend { order: 7; display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; font-size: 15px; font-weight: 500; color: var(--ink); }
  .legend span { display: flex; align-items: center; gap: 8px; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; }
  .legend .a { background: var(--or); box-shadow: 0 0 0 1.5px var(--bg), 0 0 0 2.5px var(--line-2); }
  .legend .e { width: 15px; height: 15px; border: 2px solid var(--teal); }
