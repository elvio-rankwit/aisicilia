---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapPreviewSlot from '../components/MapPreviewSlot.astro';
import EventCard from '../components/EventCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import CtaSegnala from '../components/CtaSegnala.astro';
import SiciliaDots from '../components/SiciliaDots.astro';
import SearchForm from '../components/SearchForm.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { getArticles, getCompanies, getPrompts, getUpcomingEvents } from '../lib/data';
import { meta } from '../lib/seo/meta';
import { countByProvince, plural } from '../components/helpers';

const [companies, events, articles, prompts] = await Promise.all([getCompanies(), getUpcomingEvents(), getArticles(), getPrompts()]);
const counts = countByProvince(companies);
const nextEvents = events.slice(0, 3);
const featured = companies.filter((c) => c.data.featured).slice(0, 2);
const latest = [...articles].sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime()).slice(0, 3);
const m = meta.home();

const quick = [
  { href: '/aziende/', title: 'Aziende', n: companies.length, text: companies.length ? `${plural(companies.length, 'realtà siciliana', 'realtà siciliane')} con l’AI al centro del prodotto o del servizio.` : 'La directory è in costruzione: le prime schede arrivano a breve.' },
  { href: '/eventi/', title: 'Eventi', n: events.length, text: events.length ? `${plural(events.length, 'evento in programma', 'eventi in programma')}, con date, luoghi e link per iscriversi.` : 'Nessun evento in programma per ora. Ne conosci uno? Segnalalo.' },
  { href: '/impara/', title: 'Impara', n: articles.length, text: articles.length ? `${plural(articles.length, 'guida pratica', 'guide pratiche')} per capire cosa fa l’AI per un’impresa, cosa no e quanto costa.` : 'Le prime guide per le imprese sono in preparazione.' },
  { href: '/prompt/', title: 'Prompt', n: prompts.length, text: prompts.length ? `${plural(prompts.length, 'prompt pronto', 'prompt pronti')} da copiare, divisi per settore, con esempi e avvertenze.` : 'La libreria di prompt è in preparazione.' },
];
---
<BaseLayout seo={{ title: m.title, description: m.description, path: '/' }}>
  <section slot="hero" class="hero" aria-labelledby="h-hero">
    <div class="container hero-in">
      <div class="copy">
        <p class="eyebrow">Progetto indipendente · Beta</p>
        <h1 id="h-hero">L’intelligenza artificiale in Sicilia: chi la fa, dove, quando</h1>
        <p class="answer">AI Sicilia raccoglie le aziende, gli eventi, le guide e i prompt sull’intelligenza artificiale in Sicilia. Ogni scheda ha le sue fonti e la data dell’ultima verifica, così sai da dove viene ogni dato. Il portale lo gestisce Elvio Leonardi, consulente SEO e GEO con base a Palermo.</p>
        <SearchForm large id="q-home" label="Cerca aziende, eventi, guide e prompt" placeholder="Cerca nel sito" />
        <p class="quick">
          <a href="/aziende/" data-astro-prefetch>Esplora le aziende <span aria-hidden="true">→</span></a>
          <a href="/eventi/" data-astro-prefetch>Prossimi eventi <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="map">
        <SiciliaDots companies={companies.map((c) => c.data)} events={events.filter((e) => e.data.lat !== undefined).map((e) => ({ lat: e.data.lat!, lng: e.data.lng! }))} label="La Sicilia con le aziende e gli eventi del portale" />
      </div>
    </div>
  </section>

  <section slot="hero" class="container numbers" aria-label="Accessi rapidi">
    <ul>
      {quick.map((q) => (
        <li>
          <a href={q.href} data-astro-prefetch>
            <span class="num">{q.n}</span>
            <h2>{q.title}</h2>
            <p>{q.text}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {featured.length > 0 && (
    <section class="section" aria-labelledby="h-evidenza">
      <div class="section-head">
        <h2 id="h-evidenza">In evidenza</h2>
        <a href="/aziende/" data-astro-prefetch>Tutte le aziende</a>
      </div>
      <ul class="grid">{featured.map((c) => <CompanyCard company={c} />)}</ul>
    </section>
  )}

  <section class="section" aria-labelledby="h-eventi">
    <div class="section-head">
      <h2 id="h-eventi">Prossimi eventi</h2>
      <a href="/eventi/" data-astro-prefetch>Tutti gli eventi</a>
    </div>
    {nextEvents.length ? (
      <ul class="grid">{nextEvents.map((e) => <EventCard event={e} />)}</ul>
    ) : (
      <EmptyState text="Nessun evento in programma per ora. Ne conosci uno? Segnalalo." />
    )}
  </section>

  <section class="section" aria-labelledby="h-mappa">
    <div class="section-head">
      <h2 id="h-mappa">Le aziende, provincia per provincia</h2>
      <a href="/aziende/" data-astro-prefetch>Vai alla directory</a>
    </div>
    <MapPreviewSlot counts={counts} mode="link" basePath="/aziende/provincia/" label="Aziende AI per provincia siciliana" />
  </section>

  <section class="section trust" aria-labelledby="h-fiducia">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
    <div>
      <h2 id="h-fiducia">Come verifichiamo i dati</h2>
      <p>Ogni scheda rimanda alle fonti che abbiamo consultato e porta la data dell’ultima verifica. Le descrizioni le riscriviamo noi, senza copiare i testi altrui. Pubblichiamo solo dati aziendali: niente nomi di persone, niente contatti privati.</p>
      <p><a href="/metodologia/">Leggi la metodologia</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-guide">
    <div class="section-head">
      <h2 id="h-guide">Ultime guide</h2>
      <a href="/impara/" data-astro-prefetch>Tutte le guide</a>
    </div>
    {latest.length ? (
      <ul class="grid">{latest.map((a) => <ArticleCard article={a} />)}</ul>
    ) : (
      <EmptyState text="Le prime guide sono in preparazione." cta={false} />
    )}
  </section>

  <CtaSegnala text="Fai o conosci qualcosa di interessante sull’AI in Sicilia? Segnalalo: controlliamo le fonti e lo aggiungiamo se rispetta i criteri." />
</BaseLayout>
<style>
  .hero { padding-block: var(--space-6) var(--space-7); }
  .hero-in { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 56rem) { .hero { padding-block: var(--space-8) var(--space-8); } .hero-in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-8); } }
  .hero h1 { margin-bottom: var(--space-4); max-width: 17em; }
  .hero .answer { margin-bottom: var(--space-6); }
  .quick { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); margin: var(--space-3) 0 0; }
  .quick a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap); font-weight: 600; text-decoration: none; }
  .quick a:hover { text-decoration: underline; }
  .map { max-width: 30rem; width: 100%; justify-self: center; }
  .numbers ul { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); margin: 0; padding: 0; list-style: none; }
  .numbers li { display: flex; }
  .numbers ul { gap: var(--space-3); }
    .numbers a { display: block; width: 100%; padding: var(--space-4); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); color: var(--c-text); text-decoration: none; transition: border-color var(--ease); }
  .numbers a:hover { border-color: var(--c-primary); color: var(--c-text); }
  .numbers .num { display: block; font-family: var(--font-serif); font-weight: 600; font-size: 2.5rem; line-height: 1; color: var(--c-primary); margin-bottom: var(--space-2); }
  @media (min-width: 48rem) { .numbers ul { gap: var(--space-5); grid-template-columns: repeat(4, minmax(0, 1fr)); } .numbers a { padding: var(--space-5); } .numbers .num { font-size: 3rem; margin-bottom: var(--space-3); } }
  .numbers h2 { margin: 0 0 var(--space-2); font-family: var(--font-sans); font-size: var(--fs-md); font-weight: 600; letter-spacing: 0; }
  .numbers a:hover h2 { color: var(--c-primary); text-decoration: underline; }
  .numbers p { margin: 0; font-size: var(--fs-sm); color: var(--c-text-muted); }
  .trust { display: grid; gap: var(--space-5); padding: var(--space-6); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-lg); }
  @media (min-width: 40rem) { .trust { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-6); padding: var(--space-7); } }
  .trust svg { color: var(--c-data); }
  .trust h2 { margin: 0 0 var(--space-3); }
  .trust p { max-width: var(--measure); }
  .trust p:last-child { margin: 0; }
</style>
