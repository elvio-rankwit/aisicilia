<script>
  // Letture sulla mappa: passando (o con la tastiera) su una provincia la scheda "Provincia" mostra i suoi numeri.
  const rv = document.getElementById('rov');
  const rd = document.getElementById('rod');
  if (rv && rd) {
    const home = rd.innerHTML;
    const t0 = rv.textContent;
    const show = (a: Element) => {
      const c = Number(a.getAttribute('data-c')), e = Number(a.getAttribute('data-e'));
      rv.textContent = (a.getAttribute('aria-label') ?? '').split(':')[0];
      rd.innerHTML = (c ? `<b>${c}</b> ${c === 1 ? 'azienda' : 'aziende'}, ` : 'Nessuna azienda ancora, ') + `<u>${e}</u> ${e === 1 ? 'evento' : 'eventi'} in programma.`;
    };
    document.querySelectorAll('.hero-map a[data-p]').forEach((a) => {
      a.addEventListener('mouseenter', () => show(a));
      a.addEventListener('focus', () => show(a));
      a.addEventListener('mouseleave', () => { rv.textContent = t0; rd.innerHTML = home; });
    });
  }
  // Copia il prompt completo negli appunti.
  const cp = document.getElementById('cp');
  const lab = document.getElementById('cpt');
  if (cp && lab) {
    cp.addEventListener('click', async () => {
      const text = cp.getAttribute('data-text') ?? '';
      try { await navigator.clipboard.writeText(text); lab.textContent = 'Copiato'; } catch { lab.textContent = 'Non riuscito'; }
      setTimeout(() => { lab.textContent = 'Copia'; }, 1800);
    });
  }
</script>
