---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import Prose from '../../../components/Prose.astro';
import PromptCard from '../../../components/PromptCard.astro';
import CompanyCard from '../../../components/CompanyCard.astro';
import EventCard from '../../../components/EventCard.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { formatDate, getArticles, getCompanies, getPrompts, getUpcomingEvents } from '../../../lib/data';
import { eventsForArticle, nextArticle, promptsForArticle } from '../../../lib/related';
import { meta } from '../../../lib/seo/meta';
import { articleNodes } from '../../../lib/seo/jsonld';
import { PROMPT_SECTORS, PROMPT_SECTOR_SLUGS } from '../../../lib/taxonomies';
import { RESERVED_SLUGS, SECTOR_TO_COMPANY_SECTORS, cap, hostOf } from '../../../components/helpers';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.filter((a) => !RESERVED_SLUGS.includes(a.id)).map((a) => ({ params: { slug: a.id }, props: { id: a.id } }));
}
const articles = await getArticles();
const a = articles.find((x) => x.id === Astro.props.id)!;
const d = a.data;
const { Content, headings } = await render(a);
// Il box "In pratica" è un <aside> nel Markdown: con role="note" non diventa un landmark annidato.
const bodyHtml = a.rendered?.html?.replace(/<aside(\s+class="in-(?:pratica|breve)")/g, '<aside role="note"$1');
const toc = headings.filter((h) => h.depth === 2);
const prompts = promptsForArticle(a, await getPrompts(), 4);
const next = nextArticle(a, articles);
const sectorKeys = d.sectors.includes('tutti') ? PROMPT_SECTOR_SLUGS : (d.sectors as (keyof typeof PROMPT_SECTORS)[]);
const wanted = new Set(sectorKeys.flatMap((s) => SECTOR_TO_COMPANY_SECTORS[s] ?? []));
const allCompanies = await getCompanies();
const companies = (d.sectors.includes('tutti') ? [] : allCompanies.filter((c) => c.data.sectors_served.some((s) => wanted.has(s)))).slice(0, 3);
const { events, matched } = eventsForArticle(a, await getUpcomingEvents(), 2);
const m = meta.article(a);
const path = `/impara/${a.id}/`;
const sameDay = d.updated_at.getTime() === d.published_at.getTime();
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path, type: 'article',
    breadcrumbs: [{ name: 'Guide', path: '/impara/' }, { name: d.title, path }],
    jsonld: articleNodes(a),
    publishedAt: d.published_at, modifiedAt: d.updated_at,
  }}
>
  <article>
    <PageHead size="md">
      <Fragment slot="eyebrow">Guida · {cap(d.level)} · {d.reading_time} min di lettura</Fragment>
      <Fragment slot="title">{d.title}</Fragment>
      <p>{d.answer}</p>
      <p slot="meta" class="byline">
        <span class="av" aria-hidden="true">EL</span>
        <span>Di <a href="/chi-siamo/">Elvio Leonardi</a> · pubblicato il <time datetime={d.published_at.toISOString().slice(0, 10)}>{formatDate(d.published_at)}</time>{!sameDay && <> · <strong>aggiornato il <time datetime={d.updated_at.toISOString().slice(0, 10)}>{formatDate(d.updated_at)}</time></strong></>}</span>
      </p>
    </PageHead>

    <div class="art-layout">
      {toc.length > 1 && (
        <nav class="toc" aria-labelledby="h-indice">
          <p class="label" id="h-indice">In questa guida</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="art-main">
        <Prose class="guide">{bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}</Prose>

        <section class="section" aria-labelledby="h-faq">
          <h2 id="h-faq">Domande frequenti</h2>
          <div class="faq">
            {d.faq.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="section" aria-labelledby="h-fonti">
          <h2 id="h-fonti">Fonti</h2>
          <Prose>
            <ol class="src">
              {d.sources.map((s) => <li><a class="ext" href={s.url} rel="noopener">{s.title}</a> <span class="muted">({hostOf(s.url)})</span></li>)}
            </ol>
            <p class="muted small">Gli strumenti citati sono esempi e valgono alla data di aggiornamento della guida.</p>
          </Prose>
        </section>

        <footer class="signature">
          <span class="av big" aria-hidden="true">EL</span>
          <div>
            <p class="label">L’autore</p>
            <p><strong>Elvio Leonardi</strong>, consulente SEO e GEO con base a Palermo. Hai un dubbio o una correzione? Scrivimi dalla pagina <a href="/contatti/">Contatti</a>.</p>
          </div>
        </footer>
      </div>
    </div>
  </article>

  {prompts.length > 0 && (
    <section class="section" aria-labelledby="h-prompt">
      <h2 id="h-prompt">Prompt da provare</h2>
      <ul class="grid">{prompts.map((p) => <PromptCard prompt={p} />)}</ul>
    </section>
  )}

  {companies.length > 0 && (
    <section class="section" aria-labelledby="h-aziende">
      <div class="section-head">
        <h2 id="h-aziende">Chi ci lavora in Sicilia</h2>
        <a href="/aziende/">Tutte le aziende</a>
      </div>
      <ul class="grid">{companies.map((c) => <CompanyCard company={c} />)}</ul>
    </section>
  )}

  {events.length > 0 && (
    <section class="section" aria-labelledby="h-eventi">
      <div class="section-head">
        <h2 id="h-eventi">{matched ? 'Eventi in programma su questo tema' : 'Prossimi eventi'}</h2>
        <a href="/eventi/">Tutti gli eventi</a>
      </div>
      <ul class="grid">{events.map((e) => <EventCard event={e} />)}</ul>
    </section>
  )}

  {next && (
    <section class="section" aria-labelledby="h-next">
      <h2 id="h-next">Guida successiva</h2>
      <ul class="grid"><ArticleCard article={next} /></ul>
    </section>
  )}
</BaseLayout>
<style>
  .byline { display: flex; align-items: center; gap: var(--space-3); margin: var(--space-4) 0 0; font-size: 15px; color: var(--muted); }
  .ph :global(.byline) { font-size: 15px; }
  .av { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--or); border: 1.5px solid var(--on-or); color: var(--on-or); font: 800 13px/1 var(--body); letter-spacing: 0; }
  .av.big { width: 56px; height: 56px; font-size: 16px; }
  .art-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .art-main { min-width: 0; }
  .toc { padding: var(--space-4) var(--space-5); background: var(--grey); border: 1.5px solid var(--bd); border-radius: var(--r); max-width: 40rem; }
  .toc .label { margin-bottom: var(--space-2); }
  .toc ol { margin: 0; padding-left: 1.4em; font-size: 15.5px; line-height: 1.4; }
  .toc li::marker { color: var(--or-text); font-weight: 800; }
  .toc a { display: block; padding-block: 6px; color: var(--ink); text-decoration: none; }
  .toc a:hover { color: var(--brand-d); text-decoration: underline; text-decoration-color: var(--or); text-decoration-thickness: 2px; }
  @media (min-width: 75rem) {
    .art-layout { grid-template-columns: minmax(0, 46rem) 16rem; justify-content: space-between; gap: var(--space-8); align-items: start; }
    .toc { grid-column: 2; grid-row: 1; position: sticky; top: var(--space-5); max-height: calc(100vh - 3rem); overflow-y: auto; }
    .art-main { grid-column: 1; grid-row: 1; min-width: 0; }
  }
  .art-main > .section:first-of-type { margin-top: var(--space-8); }
  .faq { display: grid; gap: var(--space-3); max-width: 40rem; }
  .faq details { background: var(--card); border: 1.5px solid var(--bd); border-radius: var(--r); box-shadow: 4px 4px 0 var(--grey-2); transition: box-shadow var(--ease); }
  .faq details[open] { box-shadow: 4px 4px 0 var(--or); }
  .faq summary { cursor: pointer; min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-5); list-style: none; font-size: 1.0625rem; line-height: 1.4; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: ''; flex: none; width: 11px; height: 11px; border-right: 3px solid var(--or); border-bottom: 3px solid var(--or); transform: rotate(45deg) translate(-2px, -2px); transition: transform var(--ease); }
  .faq details[open] summary::after { transform: rotate(-135deg); }
  .faq details p { margin: 0; padding: 0 var(--space-5) var(--space-5); font-size: 1.0625rem; line-height: 1.7; }
  .src { font-size: 1rem; line-height: 1.6; }
  .small { font-size: 0.9375rem; }
  .signature { display: flex; gap: var(--space-4); align-items: flex-start; margin-top: var(--space-8); padding: var(--space-5); max-width: 40rem; background: var(--grey); border: 1.5px solid var(--bd); border-radius: var(--r-lg); box-shadow: 6px 6px 0 var(--grey-2); }
  .signature p { margin: 0; line-height: 1.6; }
  .signature .label { margin-bottom: var(--space-1); }
</style>
