---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPreviewSlot from '../../../components/MapPreviewSlot.astro';
import MapInteractiveSlot from '../../../components/MapInteractiveSlot.astro';
import SourceBox from '../../../components/SourceBox.astro';
import EventCard from '../../../components/EventCard.astro';
import CompanyCard from '../../../components/CompanyCard.astro';
import { formatDate, getCompanies, getUpcomingEvents } from '../../../lib/data';
import { relatedCompanies } from '../../../lib/related';
import { meta } from '../../../lib/seo/meta';
import { companyNodes } from '../../../lib/seo/jsonld';
import { PROVINCES } from '../../../lib/provinces';
import { COMPANY_TYPE_ARTICLE, RESERVED_SLUGS, cleanName, companyPoints, countByProvince, hostOf, initials, joinIt, toneOf } from '../../../components/helpers';

export async function getStaticPaths() {
  const companies = await getCompanies();
  return companies.filter((c) => !RESERVED_SLUGS.includes(c.id)).map((c) => ({ params: { slug: c.id }, props: { id: c.id } }));
}
const all = await getCompanies();
const c = all.find((x) => x.id === Astro.props.id)!;
const d = c.data;
const prov = PROVINCES[d.province];
const upcoming = await getUpcomingEvents();
const events = upcoming.filter((e) => e.data.province === d.province).slice(0, 3);
const related = relatedCompanies(c, all, 4);
const m = meta.company(c);
const path = `/aziende/${c.id}/`;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const answer = [
  `${d.name} è ${COMPANY_TYPE_ARTICLE[d.type] ?? 'una realtà'} con sede a ${d.city}, in provincia di ${prov.name}.`,
  `Lavora su ${joinIt(d.ai_areas.slice(0, 3))}${d.ai_areas.length > 3 ? ' e altri ambiti' : ''} e si rivolge a ${joinIt(d.sectors_served.slice(0, 3))}${d.sectors_served.length > 3 ? ' e altri settori' : ''}.`,
  [d.founded_year ? `Anno di fondazione: ${d.founded_year}.` : '', d.is_innovative_startup === true ? 'Risulta tra le startup innovative.' : ''].filter(Boolean).join(' '),
].filter(Boolean).join(' ');
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path,
    breadcrumbs: [{ name: 'Aziende', path: '/aziende/' }, { name: prov.name, path: `/aziende/provincia/${d.province}/` }, { name: cleanName(d.name), path }],
    jsonld: companyNodes(c),
    modifiedAt: d.last_verified,
  }}
>
  <article>
    <header class="page-head head">
      <span class={`avatar tone-${toneOf(c.id)}`} aria-hidden="true">{initials(d.name)}</span>
      <div>
        <p class="eyebrow">{[prov.sigla, d.type.toUpperCase(), d.founded_year].filter(Boolean).join(' · ')}</p>
        <h1>{d.name}</h1>
        <p class="lead">{d.city}, provincia di <a href={`/aziende/provincia/${d.province}/`}>{prov.name}</a></p>
        {d.is_innovative_startup && <ul class="tags"><li><span class="badge accent">Startup innovativa</span></li></ul>}
      </div>
    </header>

    <p class="answer">{answer}</p>
    <div class="prose">
      <p class="desc">{d.description}</p>
    </div>

    <section aria-labelledby="h-dati" class="section">
      <h2 id="h-dati">I dati in breve</h2>
      <dl class="facts">
        <dt>Sito</dt>
        <dd><a class="ext" href={d.website} rel="noopener">{hostOf(d.website)}</a></dd>
        <dt>Dove</dt>
        <dd>{d.city} ({prov.sigla}){d.address ? `, ${d.address}` : ''}</dd>
        <dt>Ambiti AI</dt>
        <dd>{d.ai_areas.join(', ')}</dd>
        <dt>Settori serviti</dt>
        <dd>{d.sectors_served.map(cap).join(', ')}</dd>
        {d.founded_year && <><dt>Anno di fondazione</dt><dd>{d.founded_year}</dd></>}
        {d.is_innovative_startup === true && <><dt>Startup innovativa</dt><dd>Sì, risulta nel registro ufficiale (fonte qui sotto)</dd></>}
      </dl>
    </section>

    <SourceBox urls={d.source_urls} verified={d.last_verified} what="scheda" />
    <p><a href={`/rimozione/?scheda=${c.id}`}>Richiedi modifica o rimozione di questa scheda</a></p>

    <section aria-labelledby="h-mappa" class="section">
      <h2 id="h-mappa">Dove si trova</h2>
      <p class="muted">{d.geo_precision === 'indirizzo' ? 'Posizione ricavata dall’indirizzo pubblico della sede.' : 'Posizione indicativa: centro del comune, non l’indirizzo esatto.'}</p>
      <div class="two">
        <MapPreviewSlot counts={countByProvince(all)} mode="link" basePath="/aziende/provincia/" active={d.province} label={`${cleanName(d.name)} in provincia di ${prov.name}`} points={[{ lat: d.lat, lng: d.lng }]} />
        <MapInteractiveSlot points={companyPoints([c])} center={[d.lat, d.lng]} zoom={d.geo_precision === 'indirizzo' ? 14 : 11} height={320} label={`Mappa interattiva: ${cleanName(d.name)}`} />
      </div>
    </section>
  </article>

  {related.length > 0 && (
    <section class="section" aria-labelledby="h-correlate">
      <h2 id="h-correlate">Altre realtà simili</h2>
      <ul class="grid">{related.map((r) => <CompanyCard company={r} />)}</ul>
    </section>
  )}

  {events.length > 0 && (
    <section class="section" aria-labelledby="h-eventi">
      <div class="section-head">
        <h2 id="h-eventi">Eventi a {prov.name}</h2>
        <a href={`/eventi/provincia/${d.province}/`}>Tutti gli eventi a {prov.name}</a>
      </div>
      <ul class="grid">{events.map((e) => <EventCard event={e} />)}</ul>
    </section>
  )}
</BaseLayout>
<style>
  .head { display: flex; gap: var(--space-4); align-items: flex-start; }
  .avatar { flex: none; display: none; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: var(--radius); font-family: var(--font-mono); font-weight: 500; font-size: var(--fs-2xl); background: var(--c-primary-soft); color: var(--c-primary); }
  @media (min-width: 30rem) { .avatar { display: inline-flex; } }
  .tone-1 { background: var(--c-accent-soft); color: var(--c-accent); }
  .tone-2 { background: var(--c-surface-2); color: var(--c-text); }
  .tone-3 { background: var(--c-warning-bg); color: var(--c-warning-text); }
  .desc { font-size: var(--fs-lg); line-height: 1.6; }
  .two { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 56rem) { .two { grid-template-columns: 1fr 1fr; } }
</style>
