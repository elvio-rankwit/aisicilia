---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapPreviewSlot from '../../../components/MapPreviewSlot.astro';
import MapInteractiveSlot from '../../../components/MapInteractiveSlot.astro';
import CompanyList from '../../../components/CompanyList.astro';
import EventCard from '../../../components/EventCard.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import DirHero from '../../../components/DirHero.astro';
import SecHead from '../../../components/SecHead.astro';
import EmptyList from '../../../components/EmptyList.astro';
import OtherProvinces from '../../../components/OtherProvinces.astro';
import CtaSegnala from '../../../components/CtaSegnala.astro';
import { formatDate, getAllEvents, getArticles, getCompanies, getUpcomingEvents, latestDate } from '../../../lib/data';
import { sectorsForProvince, articlesForSector } from '../../../lib/related';
import { meta } from '../../../lib/seo/meta';
import { collectionPageNodes, itemListNodes } from '../../../lib/seo/jsonld';
import { PROVINCES, PROVINCE_SLUGS, type ProvinceSlug } from '../../../lib/provinces';
import { companyPoints, countByProvince, joinIt, plural } from '../../../components/helpers';

export function getStaticPaths() {
  return PROVINCE_SLUGS.map((provincia) => ({ params: { provincia } }));
}
const slug = Astro.params.provincia as ProvinceSlug;
const prov = PROVINCES[slug];
const [all, upcoming, articles, anyEvents] = await Promise.all([getCompanies(), getUpcomingEvents(), getArticles(), getAllEvents()]);
const companies = all.filter((c) => c.data.province === slug);
const counts = countByProvince(all);
const upcomingHere = upcoming.filter((e) => e.data.province === slug).length;
const events = upcoming.filter((e) => e.data.province === slug).slice(0, 3);
const sectors = sectorsForProvince(slug, all, upcoming);
const related = [...new Map(sectors.flatMap((s) => articlesForSector(s, articles, 2)).map((a) => [a.id, a])).values()].slice(0, 3);
const updated = latestDate(companies.map((c) => c.data.last_verified));
const m = meta.companiesProvince(slug, companies.length);
const path = `/aziende/provincia/${slug}/`;
const h1 = `Aziende AI in provincia di ${prov.name}`;
const nOthers = PROVINCE_SLUGS.filter((p) => p !== slug && counts[p] > 0).sort((a, b) => counts[b] - counts[a]).slice(0, 3);
const arrow = 'M3 8h9m-3.5-4L12.5 8 8.5 12';
---
<BaseLayout
  seo={{
    title: m.title, description: m.description, path,
    noindex: companies.length === 0 && !anyEvents.some((e) => e.data.province === slug),
    breadcrumbs: [{ name: 'Aziende', path: '/aziende/' }, { name: prov.name, path }],
    jsonld: [
      ...collectionPageNodes({ path, name: h1, description: m.description }),
      ...itemListNodes({ path, name: h1, items: companies.map((c) => ({ url: `/aziende/${c.id}/`, name: c.data.name })) }),
    ],
  }}
>
  <DirHero eyebrow={`Provincia · ${prov.ente}`} id="h-top">
    <Fragment slot="title">Aziende <mark class="blk">AI</mark> in provincia di {prov.name}</Fragment>
    {companies.length > 0 ? (
      <>
        <p>In provincia di {prov.name} abbiamo <b>{plural(companies.length, 'azienda verificata', 'aziende verificate')}</b> che lavorano con l’intelligenza artificiale, su {all.length} in tutta la Sicilia.</p>
        <p>Ultimo aggiornamento: {updated && formatDate(updated)}. Fonti e data di verifica sono nella scheda di ogni azienda.</p>
      </>
    ) : (
      <>
        <p>Nessuna azienda AI verificata in provincia di {prov.name}, per ora. In tutta la Sicilia ne abbiamo {all.length}.</p>
        <p>Ne conosci una che manca? <a href="/segnala/">Segnalala</a>: la controlliamo sulle fonti pubbliche.</p>
      </>
    )}
    <dl slot="after" class="figs">
      <div><dt>{companies.length === 1 ? 'azienda verificata' : 'aziende verificate'}</dt><dd>{companies.length}</dd></div>
      <div><dt>{events.length === 1 ? 'evento in zona' : 'eventi in zona'}</dt><dd>{upcomingHere}</dd></div>
      <div><dt>in tutta la Sicilia</dt><dd>{all.length}</dd></div>
    </dl>
    <Fragment slot="side">
      <MapPreviewSlot variant="hero" counts={counts} mode="link" basePath="/aziende/provincia/" active={slug} label={`Aziende AI in provincia di ${prov.name}, evidenziata sulla mappa della Sicilia`} points={companies.map((c) => ({ lat: c.data.lat, lng: c.data.lng }))} />
      <ul class="legend" aria-label="Legenda della mappa">
        <li><i class="a"></i>Un punto per azienda</li>
        <li><i class="t"></i>Più aziende, blu più scuro</li>
      </ul>
    </Fragment>
  </DirHero>

  <section class="section" aria-labelledby="h-elenco">
    <SecHead id="h-elenco" eyebrow="Elenco" title={`Le aziende di ${prov.name}`} />
    {companies.length > 0 ? (
      <CompanyList companies={companies} withProvinceFilter={false} />
    ) : (
      <EmptyList title={`Nessuna azienda a ${prov.name}, per ora`}>
        <p>Una provincia a zero vuol dire solo che non abbiamo ancora trovato un’azienda con fonti verificabili.{nOthers.length > 0 && <> Le province con più aziende sono {joinIt(nOthers.map((p) => `${PROVINCES[p].name} (${counts[p]})`))}.</>}</p>
        <Fragment slot="actions">
          <a class="btn p" href="/segnala/">Segnala un’azienda</a>
          <a class="btn" href="/aziende/">Tutte le aziende</a>
        </Fragment>
      </EmptyList>
    )}
  </section>

  {companies.length > 0 && (
    <section class="section" aria-labelledby="h-mappa">
      <SecHead id="h-mappa" eyebrow="Mappa" title="Dove si trovano" sub="Il punto è l’indirizzo pubblico della sede, oppure il centro del comune quando l’indirizzo non c’è." />
      <MapInteractiveSlot auto points={companyPoints(companies)} center={prov.center} zoom={prov.zoom} label={`Mappa delle aziende AI in provincia di ${prov.name}`} />
    </section>
  )}

  <section class="section" aria-labelledby="h-eventi">
    <SecHead id="h-eventi" eyebrow="Eventi" title="Eventi in zona">
      <a slot="more" class="more" href={`/eventi/provincia/${slug}/`}>Tutti gli eventi a {prov.name} <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </SecHead>
    {events.length > 0 ? (
      <ul class="grid">{events.map((e) => <EventCard event={e} />)}</ul>
    ) : (
      <EmptyList title={`Nessun evento in programma a ${prov.name}`}>
        <p>Quando ne arriva uno, lo trovi qui e nel calendario. Ne conosci uno? Mandaci il link alla pagina dell’organizzatore.</p>
        <Fragment slot="actions"><a class="btn p" href="/segnala/">Segnala un evento</a><a class="btn" href="/eventi/">Calendario completo</a></Fragment>
      </EmptyList>
    )}
  </section>

  {related.length > 0 && (
    <section class="section" aria-labelledby="h-guide">
      <SecHead id="h-guide" eyebrow="Guide" title="Guide per le imprese della zona" />
      <ul class="grid">{related.map((a) => <ArticleCard article={a} />)}</ul>
    </section>
  )}

  <OtherProvinces current={slug} counts={counts} basePath="/aziende/provincia/" label="Le altre province" />
  <CtaSegnala />
</BaseLayout>
