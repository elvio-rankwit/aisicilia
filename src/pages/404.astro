---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SearchForm from '../components/SearchForm.astro';

const sections = [
  { href: '/aziende/', title: 'Aziende', text: 'Chi fa AI in Sicilia, provincia per provincia.' },
  { href: '/eventi/', title: 'Eventi', text: 'Gli appuntamenti in programma e l’archivio.' },
  { href: '/impara/', title: 'Impara', text: 'Guide pratiche per le imprese.' },
  { href: '/prompt/', title: 'Prompt', text: 'Prompt pronti da copiare, per settore.' },
];
---
<BaseLayout seo={{ title: 'Pagina non trovata', description: 'La pagina che cerchi non esiste o è stata spostata. Prova con la ricerca o vai a una delle sezioni di AI Sicilia.', path: '/404/', noindex: true }}>
  <PageHead>
    <Fragment slot="eyebrow">Errore 404</Fragment>
    <Fragment slot="title">Questa pagina <mark class="blk">non c’è</mark></Fragment>
    <p>L’indirizzo potrebbe essere sbagliato, oppure la scheda è stata tolta. Prova a cercarla.</p>
  </PageHead>
  <SearchForm id="q404" label="Cerca nel sito" />
  <section class="section" aria-labelledby="h-sezioni">
    <h2 id="h-sezioni">Oppure vai in una sezione</h2>
    <ul class="grid">
      {sections.map((s) => (
        <li class="card sec"><p class="kicker">Sezione</p><h3><a href={s.href}>{s.title}</a></h3><p class="desc">{s.text}</p></li>
      ))}
    </ul>
    <p><a class="more" href="/">Torna alla home <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9m-3.5-4L12.5 8 8.5 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>
</BaseLayout>
<style>
  .sec { background: var(--grey); }
</style>
