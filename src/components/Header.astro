---
const path = Astro.url.pathname;
const nav = [
  { href: '/aziende/', label: 'Aziende' },
  { href: '/eventi/', label: 'Eventi' },
  { href: '/impara/', label: 'Impara' },
  { href: '/prompt/', label: 'Prompt' },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label="AI Sicilia, torna alla home">
      <svg class="glyph" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><rect class="g1" x="1" y="1" width="8" height="8" /><rect class="g2" x="11" y="1" width="8" height="8" /><rect class="g3" x="1" y="11" width="8" height="8" /><rect class="g4" x="11" y="11" width="8" height="8" /></svg>
      <span>AI Sicilia</span>
    </a>
    <span class="beta" title="Versione di prova: dati e testi in revisione">Beta</span>
    <div class="tools">
      <a class="icon-btn" href="/cerca/" aria-label="Cerca nel sito" data-astro-prefetch>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <button type="button" class="icon-btn js-only inline" id="theme-toggle" data-mode="system" aria-label="Tema: automatico. Premi per cambiare">
        <svg class="i-light" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
        <svg class="i-dark" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="i-system" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" /></svg>
      </button>
    </div>
    <nav aria-label="Principale">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} data-astro-prefetch aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--c-border); background: var(--c-surface); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-3); row-gap: 0; padding-block: var(--space-1); }
  .logo { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap); font-weight: 700; font-size: var(--fs-lg); letter-spacing: -0.02em; color: var(--c-text); text-decoration: none; }
  .glyph { flex: none; }
  .g1 { fill: var(--c-primary); } .g2 { fill: var(--c-accent); } .g3 { fill: var(--c-data); } .g4 { fill: var(--c-ochre); }
  .beta { font-family: var(--font-mono); font-weight: 500; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; padding: 1px 8px; border-radius: var(--radius-sm); background: var(--c-data-soft); color: var(--c-data); }
  .tools { display: flex; margin-left: auto; order: 2; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap); padding: 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--c-text); cursor: pointer; transition: color 120ms, background-color 120ms; }
  .icon-btn:hover { background: var(--c-primary-soft); color: var(--c-primary); }
  #theme-toggle svg { display: none; }
  #theme-toggle[data-mode='light'] .i-light, #theme-toggle[data-mode='dark'] .i-dark, #theme-toggle[data-mode='system'] .i-system { display: block; }
  nav { order: 3; flex: 1 0 100%; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-1); list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--space-2); color: var(--c-text); text-decoration: none; font-weight: 600; transition: color 120ms, box-shadow 120ms; }
  nav a:hover { color: var(--c-primary); box-shadow: inset 0 -3px 0 var(--c-border); }
  nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--c-accent); }
  @media (min-width: 40rem) {
    .bar { flex-wrap: nowrap; }
    nav { order: 1; flex: 0 1 auto; margin-left: auto; }
    .tools { order: 2; margin-left: 0; }
    nav a { padding: 0 var(--space-3); }
  }
</style>
<script>
  // Toggle tema: automatico (segue il sistema) → chiaro → scuro. La scelta sta in localStorage (try/catch).
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const labels: Record<string, string> = {
      system: 'Tema: automatico, segue il dispositivo. Premi per passare al chiaro',
      light: 'Tema: chiaro. Premi per passare allo scuro',
      dark: 'Tema: scuro. Premi per tornare all’automatico',
    };
    const order = ['system', 'light', 'dark'];
    const read = (): string => {
      try { const t = localStorage.getItem('theme'); return t === 'light' || t === 'dark' ? t : 'system'; } catch { return 'system'; }
    };
    const apply = (mode: string) => {
      if (mode === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = mode;
      btn.dataset.mode = mode;
      btn.setAttribute('aria-label', labels[mode]);
    };
    apply(read());
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(btn.dataset.mode ?? 'system') + 1) % order.length];
      try { if (next === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', next); } catch {}
      apply(next);
    });
  }
</script>
