---
const path = Astro.url.pathname;
const nav = [
  { href: '/aziende/', label: 'Aziende' },
  { href: '/eventi/', label: 'Eventi' },
  { href: '/impara/', label: 'Guide' },
  { href: '/prompt/', label: 'Prompt' },
];
---
<header class="top">
  <div class="container bar">
    <a class="logo" href="/" aria-label="AI Sicilia, torna alla home">
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" rx="9" fill="#0B5FA5" stroke="currentColor" stroke-width="1.5" /><path d="M7 22l7-11 4 5.5 2.5-3.5L27 22" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" /><circle cx="18" cy="16.5" r="3" fill="#F07A1A" stroke="#101418" stroke-width="1.2" /></svg>
      <span>AI <b>Sicilia</b></span>
    </a>
    <nav class="nav" aria-label="Principale">
      {nav.map((n) => <a href={n.href} data-astro-prefetch aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="btn-s" href="/segnala/" data-astro-prefetch>Segnala</a>
    </nav>
    <div class="tools">
      <a class="icon-btn" href="/cerca/" aria-label="Cerca nel sito" data-astro-prefetch>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <button type="button" class="icon-btn js-only inline" id="theme-toggle" data-mode="system" aria-label="Tema: automatico. Premi per cambiare">
        <svg class="i-light" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
        <svg class="i-dark" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="i-system" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" /></svg>
      </button>
      <details class="menu">
        <summary>Menu</summary>
        <div class="drop">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/segnala/">Segnala</a>
        </div>
      </details>
    </div>
  </div>
</header>
<style>
  .top { position: relative; z-index: 10; background: var(--bg); border-bottom: 1.5px solid var(--bd); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 66px; }
  .logo { display: flex; align-items: center; gap: 10px; color: var(--ink); font: 800 18px/1 var(--display); letter-spacing: -0.04em; text-decoration: none; }
  .logo:hover { color: var(--ink); }
  .logo svg { flex: none; }
  .logo span { display: flex; gap: 0.45em; }
  .logo b { font-weight: 800; color: var(--brand); }
  .nav { display: none; align-items: center; gap: 4px; margin-left: auto; }
  .nav a { display: flex; align-items: center; min-height: var(--tap); padding: 10px 14px; border-radius: 10px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .nav a:hover { background: var(--brand-t); color: var(--brand-d); }
  .nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--or); border-radius: 10px 10px 0 0; }
  .nav .btn-s { margin-left: 12px; background: var(--or); color: var(--on-or); font-weight: 700; border: 1.5px solid var(--on-or); box-shadow: 3px 3px 0 var(--on-or); transition: transform 0.15s, box-shadow 0.15s; }
  .nav .btn-s:hover { background: var(--or-h); color: var(--on-or); transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--on-or); }
  .tools { display: flex; align-items: center; gap: 2px; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap); padding: 0; border: 0; border-radius: 10px; background: transparent; color: var(--ink); cursor: pointer; transition: background-color var(--ease); }
  .icon-btn:hover { background: var(--brand-t); color: var(--brand-d); }
  #theme-toggle svg { display: none; }
  #theme-toggle[data-mode='light'] .i-light, #theme-toggle[data-mode='dark'] .i-dark, #theme-toggle[data-mode='system'] .i-system { display: block; }
  .menu { position: relative; margin-left: 6px; }
  .menu summary { display: flex; align-items: center; min-height: var(--tap); padding: 0 18px; border: 1.5px solid var(--bd); border-radius: 10px; background: var(--card); font-weight: 700; list-style: none; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .drop { position: absolute; right: 0; top: 54px; width: 230px; display: grid; padding: 8px; background: var(--card); border: 1.5px solid var(--bd); border-radius: var(--r); box-shadow: 5px 5px 0 var(--sh); }
  .drop a { display: flex; align-items: center; min-height: var(--tap); padding: 0 12px; border-radius: 8px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .drop a:hover { background: var(--brand-t); }
  /* Schermi molto stretti (320–380px): tutto deve stare in una riga senza scroll orizzontale. */
  @media (max-width: 23.75rem) {
    .bar { gap: 6px; }
    .logo { font-size: 16px; gap: 7px; }
    .logo svg { width: 26px; height: 26px; }
    .tools { gap: 0; }
    .menu { margin-left: 2px; }
    .menu summary { padding: 0 12px; }
  }
  @media (min-width: 45.01rem) {
    .bar { height: 76px; }
    .logo { font-size: 21px; }
    .nav { display: flex; }
    .menu { display: none; }
    .tools { margin-left: 8px; }
  }
</style>
<script>
  // Toggle tema: automatico → opposto a quello attuale → l'altro → automatico. La scelta sta in localStorage (try/catch).
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const sys = () => (mq.matches ? 'dark' : 'light');
    const other = (m: string) => (m === 'dark' ? 'light' : 'dark');
    const name = (m: string) => (m === 'dark' ? 'scuro' : 'chiaro');
    const read = (): string => {
      try { const t = localStorage.getItem('theme'); return t === 'light' || t === 'dark' ? t : 'system'; } catch { return 'system'; }
    };
    // Cicli possibili: dal sistema chiaro: sistema → scuro → chiaro; dal sistema scuro: sistema → chiaro → scuro.
    const next = (m: string) => (m === 'system' ? other(sys()) : m === other(sys()) ? sys() : 'system');
    const label = (m: string) => {
      const n = next(m);
      const cur = m === 'system' ? `automatico, ora ${name(sys())}` : name(m);
      const to = n === 'system' ? 'automatico' : name(n);
      return `Tema: ${cur}. Premi per passare a ${to}`;
    };
    const apply = (mode: string) => {
      if (mode === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = mode;
      btn.dataset.mode = mode;
      btn.setAttribute('aria-label', label(mode));
    };
    apply(read());
    mq.addEventListener('change', () => apply(btn.dataset.mode ?? 'system'));
    btn.addEventListener('click', () => {
      const n = next(btn.dataset.mode ?? 'system');
      try { if (n === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', n); } catch {}
      apply(n);
    });
  }
</script>
