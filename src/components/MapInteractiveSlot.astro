---
// Mappa interattiva. Usa InteractiveMap del map-engineer quando il file esiste;
// altrimenti un contenitore a altezza fissa (CLS 0).
import type { ProvinceSlug } from '../lib/provinces';
interface Point { id: string; lat: number; lng: number; title: string; url: string; province: ProvinceSlug; subtitle?: string }
interface Props { points: Point[]; center?: [number, number]; zoom?: number; height?: number; label: string; auto?: boolean }
const props = Astro.props;
const mods = import.meta.glob<{ default: any }>('./map/InteractiveMap.astro', { eager: true });
const MapComp = Object.values(mods)[0]?.default;
---
{MapComp ? (
  <MapComp points={props.points} center={props.center} zoom={props.zoom} height={props.height} label={props.label} auto={props.auto} />
) : (
  <div class="map-ph" role="group" aria-label={props.label}>
    <!-- MAP: qui va <InteractiveMap points center zoom height label /> di src/components/map/ (map-engineer) -->
    <p class="muted">Mappa interattiva in arrivo. L’elenco qui sotto è già consultabile.</p>
  </div>
)}
<style>
  .map-ph { height: 320px; padding: var(--space-4); background: var(--map-zero); border: 1.5px dashed var(--line-2); border-radius: var(--r); display: flex; align-items: center; justify-content: center; text-align: center; }
  .map-ph p { margin: 0; }
  @media (min-width: 48rem) { .map-ph { height: 420px; } }
</style>
