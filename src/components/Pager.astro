---
// Paginazione statica: la pagina 1 sta sulla rotta base, le altre in {base}pagina/{n}/.
interface Props { base: string; current: number; total: number }
const { base, current, total } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}pagina/${n}/`);
---
{total > 1 && (
  <nav class="pg" aria-label="Pagine dell’elenco">
    <p class="of">Pagina {current} di {total}</p>
    <ul class="pager">
      {current > 1 && <li><a href={href(current - 1)} rel="prev">Precedente</a></li>}
      {Array.from({ length: total }, (_, i) => i + 1).map((n) => (
        <li>{n === current ? <span aria-current="page">{n}</span> : <a href={href(n)} aria-label={`Pagina ${n}`}>{n}</a>}</li>
      ))}
      {current < total && <li><a href={href(current + 1)} rel="next">Successiva</a></li>}
    </ul>
  </nav>
)}
<style>
  .pg { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; margin: 40px 0 0; }
  .of { margin: 0; font-weight: 600; color: var(--muted); }
  .pager { margin: 0; }
  .pager a, .pager span { border-color: var(--bd); box-shadow: 3px 3px 0 var(--grey-2); font-weight: 700; transition: transform 0.15s, box-shadow 0.15s, background-color 0.2s; }
  .pager a:hover { background: var(--or); color: var(--on-or); transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--sh); }
  .pager [aria-current='page'] { box-shadow: 3px 3px 0 var(--sh); }
</style>
