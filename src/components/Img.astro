---
// UNICO modo di mostrare un'immagine raster nel sito: AVIF + fallback WebP, srcset responsivo,
// dimensioni esplicite, lazy di default. Per l'immagine LCP passare priority.
// Le immagini sorgente stanno in src/assets/images/ (mai in public/).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Larghezze del srcset. */
  widths?: number[];
  sizes?: string;
  /** true solo per l'immagine LCP sopra la piega. */
  priority?: boolean;
  class?: string;
}
const { src, alt, widths = [360, 720, 1080, 1440], sizes = '(min-width: 72rem) 72rem, 100vw', priority = false, class: cls } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  width={src.width}
  height={src.height}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
/>
