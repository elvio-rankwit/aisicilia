---
import type { Event } from '../lib/data';
import { PROVINCES } from '../lib/provinces';
import { clip, dateRange, eventStatus, monthKey, slugify, timeRange } from './helpers';
interface Props { event: Event; level?: 2 | 3 | 4 }
const { event: e, level = 3 } = Astro.props;
const d = e.data;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const st = eventStatus(e);
const time = timeRange(d.start_time, d.end_time);
const place = d.format === 'online' ? `Online · organizza ${d.city}` : [d.venue_name, d.city].filter(Boolean).join(', ');
---
<li
  class="card event"
  data-id={e.id}
  data-provincia={d.province}
  data-formato={slugify(d.format)}
  data-pubblico={d.audience.map(slugify).join(' ')}
  data-prezzo={slugify(d.price)}
  data-mese={monthKey(d.start_date)}
>
  <p class="when"><time datetime={d.start_date.toISOString().slice(0, 10)}>{dateRange(d.start_date, d.end_date)}</time>{time && <span class="muted"> · ore {time}</span>}</p>
  <H><a href={`/eventi/${e.id}/`}>{d.title}</a></H>
  <p class="meta">{place} ({PROVINCES[d.province].sigla})</p>
  <p>{clip(d.description, 130)}</p>
  <ul class="tags" aria-label="Dettagli">
    {st.key !== 'programmato' && <li><span class={`badge ${st.tone}`}>{st.label}</span></li>}
    <li><span class="badge">{d.format[0].toUpperCase() + d.format.slice(1)}</span></li>
    <li><span class={`badge ${d.price === 'gratuito' ? 'accent' : 'plain'}`}>{d.price[0].toUpperCase() + d.price.slice(1)}</span></li>
  </ul>
</li>
<style>
  .when { font-weight: 700; color: var(--c-accent); }
</style>
