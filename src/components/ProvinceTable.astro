---
// Tabella dati "per provincia": sempre le 9 righe, numeri in mono a destra, barra proporzionale in pistacchio.
import type { ProvinceSlug } from '../lib/provinces';
import { PROVINCES, PROVINCE_SLUGS } from '../lib/provinces';
interface Props { counts: Record<ProvinceSlug, number>; basePath: string; caption: string; header: string; unit?: [string, string]; showTotal?: boolean }
const { counts, basePath, caption, header, showTotal = true } = Astro.props;
const total = PROVINCE_SLUGS.reduce((n, p) => n + counts[p], 0);
const max = Math.max(1, ...PROVINCE_SLUGS.map((p) => counts[p]));
---
<div class="table-wrap">
  <table class="ptable">
    <caption>{caption}</caption>
    <thead><tr><th scope="col">Provincia</th><th scope="col" class="bar"><span class="visually-hidden">Proporzione</span></th><th scope="col" class="num">{header}</th></tr></thead>
    <tbody>
      {PROVINCE_SLUGS.map((p) => (
        <tr>
          <th scope="row"><a href={`${basePath}${p}/`}><span class="sg mono">{PROVINCES[p].sigla}</span> {PROVINCES[p].name}</a></th>
          <td class="bar" aria-hidden="true"><svg viewBox="0 0 100 8" preserveAspectRatio="none" width="100" height="8"><rect class="track" width="100" height="8" /><rect class="fill" width={(counts[p] / max) * 100} height="8" /></svg></td>
          <td class="num">{counts[p]}</td>
        </tr>
      ))}
    </tbody>
    {showTotal && <tfoot><tr><th scope="row" colspan="2">Totale</th><td class="num">{total}</td></tr></tfoot>}
  </table>
</div>
<style>
  tfoot th, tfoot td { font-weight: 700; border-top: 2px solid var(--c-text); border-bottom: 0; }
  .sg { display: inline-block; min-width: 2.2em; color: var(--c-text-muted); font-size: var(--fs-xs); }
  .bar { width: 30%; padding-inline: var(--space-2); }
  .bar svg { width: 100%; height: 8px; }
  .track { fill: var(--c-surface-2); }
  .fill { fill: var(--c-data); }
  thead .bar { border-bottom-color: var(--c-text); }
</style>
