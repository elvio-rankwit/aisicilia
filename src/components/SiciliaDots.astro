---
// La Sicilia come dataset: contorni delle province (path del map-engineer) e punti reali di aziende ed eventi.
// Zero JS. Usa provinces-paths.ts e project() senza modificarli.
import { PROVINCE_PATHS, VIEWBOX, VIEWBOX_W, VIEWBOX_H, project } from './map/provinces-paths';
import { PROVINCE_SLUGS } from '../lib/provinces';
interface Pt { lat: number; lng: number }
interface Props { companies: Pt[]; events: Pt[]; label: string }
const { companies, events, label } = Astro.props;
const dots = (list: Pt[]) => list.map((p) => project(p.lat, p.lng));
const cd = dots(companies);
const ed = dots(events);
// Reticolo: paralleli e meridiani interi con etichetta in mono
const lats = [37, 38];
const lngs = [12, 13, 14, 15];
---
<figure class="sdots">
  <svg viewBox={VIEWBOX} width={VIEWBOX_W} height={VIEWBOX_H} role="img" aria-label={`${label}: ${companies.length} aziende e ${events.length} eventi in programma`} focusable="false">
    <g class="graticule">
      {lats.map((l) => { const y = project(l, 12)[1]; return <><line x1="0" x2={VIEWBOX_W} y1={y} y2={y} /><text x="2" y={y - 3}>{l}°N</text></>; })}
      {lngs.map((g) => { const x = project(38, g)[0]; return <><line y1="0" y2={VIEWBOX_H} x1={x} x2={x} /><text x={x + 3} y={VIEWBOX_H - 3}>{g}°E</text></>; })}
    </g>
    <g class="outline">
      {PROVINCE_SLUGS.map((s) => <path d={PROVINCE_PATHS[s].d} />)}
    </g>
    <g class="ev">{ed.map(([x, y]) => <rect x={x - 2.8} y={y - 2.8} width="5.6" height="5.6" transform={`rotate(45 ${x} ${y})`} />)}</g>
    <g class="co">{cd.map(([x, y]) => <circle cx={x} cy={y} r="3.3" />)}</g>
  </svg>
  <figcaption>
    <span class="k"><i class="co-key"></i><span class="mono">{companies.length}</span> aziende</span>
    <span class="k"><i class="ev-key"></i><span class="mono">{events.length}</span> eventi in programma</span>
  </figcaption>
</figure>
<style>
  .sdots { margin: 0; }
  svg { width: 100%; height: auto; aspect-ratio: 391.2 / 289.4; overflow: visible; }
  .graticule line { stroke: var(--c-on-lava); stroke-opacity: 0.12; stroke-width: 0.5; }
  .graticule text { font-family: var(--font-mono); font-weight: 500; font-size: 7px; fill: var(--c-on-lava-muted); }
  .outline path { fill: var(--c-lava-2); stroke: var(--c-lava-ochre); stroke-width: 0.7; stroke-linejoin: round; }
  .co circle { fill: var(--c-lava-accent); stroke: var(--c-lava); stroke-width: 1; }
  .ev rect { fill: var(--c-lava-blue); stroke: var(--c-lava); stroke-width: 1; }
  figcaption { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); margin-top: var(--space-2); font-size: var(--fs-xs); color: var(--c-on-lava-muted); font-family: var(--font-mono); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }
  .k { display: inline-flex; align-items: center; gap: var(--space-2); }
  .k .mono { color: var(--c-on-lava); }
  i { display: inline-block; width: 10px; height: 10px; }
  .co-key { background: var(--c-lava-accent); border-radius: 50%; }
  .ev-key { background: var(--c-lava-blue); transform: rotate(45deg) scale(0.8); }
</style>
