---
// La Sicilia come dataset: contorni delle province (path del map-engineer) e punti reali di aziende ed eventi.
// Zero JS. Usa provinces-paths.ts e project() senza modificarli.
import { PROVINCE_PATHS, VIEWBOX, VIEWBOX_W, VIEWBOX_H, project } from './map/provinces-paths';
import { PROVINCE_SLUGS } from '../lib/provinces';
interface Pt { lat: number; lng: number }
interface Props { companies: Pt[]; events: Pt[]; label: string }
const { companies, events, label } = Astro.props;
const dots = (list: Pt[]) => list.map((p) => project(p.lat, p.lng));
const cd = dots(companies);
const ed = dots(events);
---
<figure class="sdots">
  <svg viewBox={VIEWBOX} width={VIEWBOX_W} height={VIEWBOX_H} role="img" aria-label={`${label}: ${companies.length} aziende e ${events.length} eventi in programma`} focusable="false">
    <g class="outline">
      {PROVINCE_SLUGS.map((s) => <path d={PROVINCE_PATHS[s].d} />)}
    </g>
    <g class="ev">{ed.map(([x, y]) => <rect x={x - 2.8} y={y - 2.8} width="5.6" height="5.6" transform={`rotate(45 ${x} ${y})`} />)}</g>
    <g class="co">{cd.map(([x, y]) => <circle cx={x} cy={y} r="3.3" />)}</g>
  </svg>
  <figcaption>
    <span class="k"><i class="co-key"></i><strong>{companies.length}</strong> aziende</span>
    <span class="k"><i class="ev-key"></i><strong>{events.length}</strong> eventi in programma</span>
  </figcaption>
</figure>
<style>
  .sdots { margin: 0; }
  svg { width: 100%; height: auto; aspect-ratio: 391.2 / 289.4; overflow: visible; }
  .outline path { fill: var(--c-map-land); stroke: var(--c-map-stroke); stroke-width: 1; stroke-linejoin: round; }
  .co circle { fill: var(--c-primary); stroke: var(--c-surface); stroke-width: 1; opacity: 0.9; }
  .ev rect { fill: var(--c-ochre); stroke: var(--c-ochre-strong); stroke-width: 0.8; }
  figcaption { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-4); font-size: var(--fs-sm); color: var(--c-text-muted); }
  strong { color: var(--c-text); font-weight: 600; }
  .k { display: inline-flex; align-items: center; gap: var(--space-2); }
  i { display: inline-block; width: 10px; height: 10px; }
  .co-key { background: var(--c-primary); border-radius: 50%; }
  .ev-key { background: var(--c-ochre); outline: 1px solid var(--c-ochre-strong); transform: rotate(45deg) scale(0.8); }
</style>
