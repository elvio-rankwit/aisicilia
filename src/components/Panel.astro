---
// Riquadro v4: bordo netto, ombra piena. tone = colore dell'ombra (soft grigio, ink, brand blu, teal per gli eventi).
interface Props { title?: string; id?: string; tone?: 'soft' | 'ink' | 'brand' | 'teal'; level?: 2 | 3 | 4; label?: string; bare?: boolean }
const { title, id, tone = 'soft', level = 3, label, bare = false } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<section class:list={['panel', tone, { bare }]} aria-labelledby={title ? id : undefined} aria-label={title ? undefined : label}>
  {title && <H id={id} class="pt">{title}</H>}
  <slot />
</section>
<style>
  .panel { --pc: var(--grey-2); min-width: 0; padding: 20px; background: var(--card); border: 1.5px solid var(--bd); border-radius: var(--r-lg); box-shadow: 5px 5px 0 var(--pc); }
  .bare { padding: 0; background: none; border: 0; border-radius: 0; box-shadow: none; }
  .ink { --pc: var(--sh); }
  .brand { --pc: var(--brand-bg); }
  .teal { --pc: var(--teal); }
  .panel > :global(:last-child) { margin-bottom: 0; }
  .pt { margin: 0 0 14px; font: 700 17px/1.3 var(--display); letter-spacing: -0.02em; }
  @media (min-width: 45.01rem) { .panel { padding: 28px; box-shadow: 8px 8px 0 var(--pc); } .bare { padding: 0; box-shadow: none; } }
</style>
