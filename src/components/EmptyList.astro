---
// Stato vuoto curato: riquadro tratteggiato con icona, titolo, spiegazione e azioni (slot "actions").
interface Props { title: string }
const { title } = Astro.props;
---
<div class="empty">
  <svg class="ico" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.800 12 21 12 21z" /><circle cx="12" cy="9.500" r="2.500" /></svg>
  <div class="tx">
    <p class="et">{title}</p>
    <div class="ed"><slot /></div>
    <div class="ea"><slot name="actions" /></div>
  </div>
</div>
<style>
  .empty { display: flex; flex-direction: column; gap: 16px; padding: 24px 20px; background: var(--grey); border: 1.5px dashed var(--line-2); border-radius: var(--r-lg); }
  .ico { flex: none; color: var(--brand); }
  .et { margin: 0 0 8px; font: 700 20px/1.3 var(--display); letter-spacing: -0.03em; }
  .ed :global(p) { max-width: 52ch; margin: 0 0 8px; color: var(--muted); }
  .ea { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .ea:empty { display: none; }
  @media (min-width: 45.01rem) { .empty { flex-direction: row; align-items: flex-start; gap: 24px; padding: 32px 36px; } }
</style>
