---
// Testata v4 delle pagine di elenco e di scheda: pannello a puntini con eyebrow, H1 Unbounded (con eventuale <mark class="blk">),
// risposta diretta e, a destra, un lato (mappa, tessera con la data). Usata solo dalle pagine aziende ed eventi.
interface Props { eyebrow: string; id?: string; tone?: 'brand' | 'teal'; compact?: boolean }
const { eyebrow, id = 'h-top', tone = 'brand', compact = false } = Astro.props;
const side = Astro.slots.has('side');
---
<header class:list={['dhero', tone, { side, compact }]}>
  <div class="copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id={id}><slot name="title" /></h1>
    <div class="body"><slot /></div>
    <slot name="after" />
  </div>
  {side && <div class="aside"><slot name="side" /></div>}
</header>
<style>
  .dhero { display: grid; gap: 28px; margin-block: 8px 56px; padding: 28px 16px 26px; background-color: var(--card); background-image: radial-gradient(circle at 1px 1px, var(--dot) 1.2px, transparent 0); background-size: 24px 24px; border: 1.5px solid var(--bd); border-radius: var(--r-lg); box-shadow: 5px 5px 0 var(--grey-2); }
  .copy { min-width: 0; }
  .copy .eyebrow { margin-bottom: 18px; line-height: 1.35; }
  h1 { max-width: 15em; margin: 0 0 20px; font-size: clamp(26px, 8vw, 40px); line-height: 1.1; letter-spacing: -0.045em; hyphens: auto; overflow-wrap: break-word; text-wrap: balance; }
  .body :global(p) { max-width: 50ch; margin: 0 0 12px; font-size: 16px; line-height: 1.55; color: var(--muted); }
  .body :global(p:first-child) { font-size: 18px; font-weight: 500; line-height: 1.5; color: var(--ink); }
  .body :global(b) { font-weight: 800; background: linear-gradient(transparent 62%, color-mix(in srgb, var(--or) 38%, transparent) 62%); }
  .body :global(a) { font-weight: 600; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .aside { min-width: 0; }
  .aside :global(.legend) { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 14px 0 0; padding: 0; list-style: none; font-size: 15px; font-weight: 500; color: var(--ink); }
  .aside :global(.legend li) { display: flex; align-items: center; gap: 8px; }
  .aside :global(.legend .js-only) { flex-basis: 100%; color: var(--muted); }
  .aside :global(.legend i) { display: inline-block; flex: none; width: 12px; height: 12px; border-radius: 50%; }
  .aside :global(.legend .a) { background: var(--or); box-shadow: 0 0 0 1.5px var(--bg), 0 0 0 2.5px var(--line-2); }
  .aside :global(.legend .e) { width: 15px; height: 15px; border: 2px solid var(--teal); }
  .aside :global(.legend .t) { width: 14px; height: 14px; border-radius: 3px; background: color-mix(in srgb, var(--map-tint) 46%, transparent); }
  .aside :global(.pmap) { margin: 0 -4px; }
  /* Numeri chiave sotto la risposta */
  .copy :global(.figs) { display: flex; flex-wrap: wrap; gap: 14px 28px; margin: 26px 0 0; padding: 18px 0 0; border-top: 1.5px solid var(--bd); }
  .copy :global(.figs > div) { min-width: 0; }
  .copy :global(.figs dd) { order: 1; margin: 0 0 4px; font: 800 28px/1 var(--display); letter-spacing: -0.05em; font-variant-numeric: tabular-nums lining-nums; color: var(--brand); }
  .teal .copy :global(.figs dd) { color: var(--teal); }
  .copy :global(.figs dd small) { font: 700 15px var(--body); letter-spacing: 0; color: var(--muted); }
  .copy :global(.figs dt) { order: 2; font: 800 12px/1.3 var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .copy :global(.figs > div) { display: flex; flex-direction: column; }
  .copy :global(.btns) { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .compact h1 { font-size: clamp(24px, 6.4vw, 34px); max-width: 22em; }
  .compact .eyebrow { font-size: 13px; }
  @media (min-width: 45.01rem) {
    .dhero { padding: 44px 44px 40px; box-shadow: 8px 8px 0 var(--grey-2); margin-bottom: 72px; }
    h1 { font-size: clamp(34px, 4.6vw, 56px); margin-bottom: 24px; }
    .compact h1 { font-size: clamp(30px, 3.6vw, 46px); }
    .body :global(p:first-child) { font-size: 20px; }
    .body :global(p) { font-size: 17px; }
    .copy :global(.figs dd) { font-size: 34px; }
  }
  @media (min-width: 62rem) {
    .dhero.side { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; align-items: center; }
  }
</style>
