---
interface Props { id?: string; label?: string; autofocus?: boolean }
const { id = 'q', label = 'Cerca aziende, eventi, guide e prompt' } = Astro.props;
---
<form class="search-form" action="/cerca/" method="get" role="search" aria-label="Cerca nel sito">
  <label for={id}>{label}</label>
  <div class="row">
    <input id={id} name="q" type="search" autocomplete="off" enterkeyhint="search" />
    <button type="submit" class="btn">Cerca</button>
  </div>
</form>
<style>
  .search-form { max-width: var(--measure); }
  label { display: block; font-weight: 600; margin-bottom: var(--space-2); }
  .row { display: flex; gap: var(--space-2); }
  input { flex: 1; min-width: 0; min-height: var(--tap); padding: var(--space-2) var(--space-3); font: inherit; color: var(--c-text); background: var(--c-surface); border: 1px solid var(--c-text-muted); border-radius: var(--radius-sm); }
</style>
