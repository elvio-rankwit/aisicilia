---
interface Props { id?: string; label?: string; large?: boolean; placeholder?: string }
const { id = 'q', label = 'Cerca aziende, eventi, guide e prompt', large = false, placeholder } = Astro.props;
---
<form class:list={['search', { large }]} action="/cerca/" method="get" role="search" aria-label="Cerca nel sito">
  <label for={id} class:list={{ 'visually-hidden': large }}>{label}</label>
  <div class="row">
    <input id={id} name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={placeholder} />
    <button type="submit">Cerca</button>
  </div>
</form>
<style>
  .search { max-width: var(--measure); }
  label { display: block; margin-bottom: 8px; font-weight: 700; }
  .row { display: flex; flex-direction: column; gap: 8px; padding: 8px; background: var(--card); border: 2px solid var(--bd); border-radius: 16px; box-shadow: 5px 5px 0 var(--brand); }
  .row:focus-within { box-shadow: 5px 5px 0 var(--or); }
  input { flex: 1; min-width: 0; min-height: 50px; padding: 0 12px; background: none; border: 0; color: var(--ink); font: 500 17px var(--body); }
  input::placeholder { color: var(--faint); opacity: 1; }
  input:focus-visible { outline: none; }
  button { min-height: 50px; padding: 0 26px; background: var(--or); color: var(--on-or); border: 0; border-radius: 11px; font: 800 17px var(--body); cursor: pointer; }
  button:hover { background: var(--or-h); }
  button:focus-visible { outline-color: var(--ink); }
  .large { max-width: 500px; margin-top: 14px; }
  @media (min-width: 45.01rem) {
    .row { flex-direction: row; gap: 0; padding: 6px; box-shadow: 6px 6px 0 var(--brand); }
    .row:focus-within { box-shadow: 6px 6px 0 var(--or); }
    input { padding: 0 14px; }
    .large { margin-top: 30px; }
  }
</style>
