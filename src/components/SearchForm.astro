---
interface Props { id?: string; label?: string; large?: boolean; placeholder?: string }
const { id = 'q', label = 'Cerca aziende, eventi, guide e prompt', large = false, placeholder } = Astro.props;
---
<form class:list={['search-form', { large }]} action="/cerca/" method="get" role="search" aria-label="Cerca nel sito">
  <label for={id} class:list={{ 'visually-hidden': large }}>{label}</label>
  <div class="row">
    <div class="field-wrap">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id={id} name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={placeholder} />
    </div>
    <button type="submit" class="btn">Cerca</button>
  </div>
</form>
<style>
  .search-form { max-width: var(--measure); }
  label { display: block; font-weight: 600; margin-bottom: var(--space-2); }
  .row { display: flex; gap: var(--space-2); }
  .field-wrap { position: relative; flex: 1; min-width: 0; color: var(--c-text-muted); }
  .field-wrap svg { position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%); pointer-events: none; }
  input { width: 100%; min-height: 48px; padding: var(--space-2) var(--space-4) var(--space-2) 3rem; color: var(--c-text); background: var(--c-surface); border: 1px solid var(--c-border-strong); border-radius: var(--radius-sm); transition: border-color var(--ease); }
  input::placeholder { color: var(--c-text-muted); opacity: 1; }
  input:hover { border-color: var(--c-primary); }
  .btn { min-height: 48px; }
  .large { max-width: 36rem; }
  .large input { min-height: 56px; font-size: var(--fs-md); border-radius: var(--radius); }
  .large .btn { min-height: 56px; padding-inline: var(--space-6); border-radius: var(--radius); }
  @media (max-width: 30rem) { .large .btn { padding-inline: var(--space-4); } }
</style>
