---
// Filtri + elenco schede aziende. Usato da /aziende/, /aziende/pagina/[n]/ e dalle pagine provincia.
import type { Company } from '../lib/data';
import { AI_AREAS, COMPANY_TYPES, SECTORS_SERVED } from '../lib/taxonomies';
import { PROVINCES, PROVINCE_SLUGS } from '../lib/provinces';
import CompanyCard from './CompanyCard.astro';
import ListFilters from './ListFilters.astro';
import { slugify } from './helpers';
interface Props { companies: Company[]; withProvinceFilter?: boolean; id?: string; level?: 2 | 3 | 4 }
const { companies, withProvinceFilter = true, id = 'elenco-aziende', level = 3 } = Astro.props;
const present = <T extends string>(all: readonly T[], pick: (c: Company) => readonly string[]) =>
  all.filter((v) => companies.some((c) => pick(c).includes(v))).map((v) => ({ value: slugify(v), label: v }));
const fields = [
  ...(withProvinceFilter
    ? [{ key: 'provincia', label: 'Provincia', options: PROVINCE_SLUGS.filter((p) => companies.some((c) => c.data.province === p)).map((p) => ({ value: p, label: PROVINCES[p].name })) }]
    : []),
  { key: 'tipo', label: 'Tipo di realtà', options: present(COMPANY_TYPES, (c) => [c.data.type]) },
  { key: 'aree', label: 'Ambito AI', options: present(AI_AREAS, (c) => c.data.ai_areas) },
  { key: 'settori', label: 'Settore servito', options: present(SECTORS_SERVED, (c) => c.data.sectors_served) },
].filter((f) => f.options.length > 1);
---
{companies.length > 1 && <ListFilters target={id} fields={fields} noun={['realtà', 'realtà']} />}
<div id={id}>
  <ul class="grid">
    {companies.map((c) => <CompanyCard company={c} level={level} />)}
  </ul>
</div>
