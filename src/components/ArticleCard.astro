---
import type { Article } from '../lib/data';
import { formatDate } from '../lib/data';
import { cap, clip } from './helpers';
interface Props { article: Article; level?: 2 | 3 | 4; big?: boolean }
const { article: a, level = 3, big = false } = Astro.props;
const d = a.data;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<li class:list={['card', 'article', { big }]} data-id={a.id} data-settori={d.sectors.join(' ')} data-livello={d.level}>
  <p class="am"><span class="lv">{cap(d.level)}</span> {d.reading_time} min di lettura</p>
  <H><a href={`/impara/${a.id}/`}>{d.title}</a></H>
  <p class="desc">{clip(d.description, 200)}</p>
  <p class="bt">Aggiornata il <time datetime={d.updated_at.toISOString().slice(0, 10)}>{formatDate(d.updated_at)}</time></p>
</li>
<style>
  .article { background: var(--grey); gap: 0; }
  .article:hover { box-shadow: 6px 6px 0 var(--sh); }
  .am { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
  .lv { padding: 6px 10px; border: 1.5px solid var(--on-or); border-radius: 99px; background: #fff; color: var(--on-or); font: 800 12px/1 var(--body); letter-spacing: 0.1em; text-transform: uppercase; }
  .article :global(h3), .article :global(h2), .article :global(h4) { margin: 20px 0 14px; line-height: 1.3; }
  .article .desc { font-size: 17px; -webkit-line-clamp: 4; line-clamp: 4; }
  .bt { margin-top: auto !important; padding-top: 24px !important; font-size: 14.5px; font-weight: 500; color: var(--faint); }
  .big { background: var(--or); color: var(--on-or); }
  .big .am, .big .desc, .big .bt { color: var(--on-or); }
  .big :global(h3), .big :global(h2), .big :global(h4) { font-size: clamp(22px, 2.1vw, 28px); line-height: 1.2; letter-spacing: -0.035em; font-weight: 800; }
  .big :global(a) { color: var(--on-or); }
  .big :global(a:focus-visible::after) { outline-color: var(--on-or); }
</style>
