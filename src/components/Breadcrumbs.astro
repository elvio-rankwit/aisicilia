---
import type { Crumb } from '../lib/seo/types';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Percorso" class="crumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { margin-block: 20px 8px; font-size: 15px; }
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 4px; list-style: none; padding: 0; margin: 0; }
  li { display: flex; align-items: center; }
  li + li::before { content: ''; width: 7px; height: 7px; margin-right: 10px; border-top: 2px solid var(--or); border-right: 2px solid var(--or); transform: rotate(45deg); flex: none; }
  a { display: inline-flex; align-items: center; min-height: var(--tap); padding-right: 10px; color: var(--brand-d); font-weight: 600; text-decoration: none; }
  a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--or); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  [aria-current] { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--muted); font-weight: 500; }
</style>
