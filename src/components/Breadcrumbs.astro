---
import type { Crumb } from '../lib/seo/types';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Percorso" class="crumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { font-size: var(--fs-sm); margin-block: var(--space-4); }
  ol { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; margin: 0; }
  li + li::before { content: '›'; margin-right: var(--space-1); color: var(--c-text-muted); }
  a { display: inline-block; padding-block: var(--space-2); }
  [aria-current] { color: var(--c-text-muted); display: inline-block; padding-block: var(--space-2); }
</style>
