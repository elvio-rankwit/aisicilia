---
import { IS_BETA as beta } from '../lib/site';
const cols = [
  { h: 'Esplora', links: [['/aziende/', 'Aziende'], ['/eventi/', 'Eventi'], ['/eventi/prossimi/', 'Prossimi 30 giorni'], ['/bandi/', 'Bandi'], ['/impara/', 'Guide'], ['/prompt/', 'Prompt'], ['/cerca/', 'Cerca']] },
  { h: 'Progetto', links: [['/metodologia/', 'Metodologia'], ['/chi-siamo/', 'Chi siamo'], ['/contatti/', 'Contatti'], ['/segnala/', 'Segnala'], ['/rivendica/', 'Rivendica la scheda'], ['/badge/', 'Badge per le aziende']] },
  { h: 'Dati e legale', links: [['/rimozione/', 'Richiedi rimozione'], ['/privacy/', 'Privacy'], ['/note-legali/', 'Note legali']] },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="fg">
      <div class="about">
        <a class="logo" href="/" aria-label="AI Sicilia, torna alla home">AI <b>Sicilia</b></a>
        <p>Portale indipendente sull’intelligenza artificiale in Sicilia. Lo cura <a href="/chi-siamo/">Elvio Leonardi</a>.</p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.h}>
          <h2>{c.h}</h2>
          <ul>{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="fb">
      <span>Confini delle province: ISTAT, 1 gennaio 2025, licenza CC BY 4.0. Mappe interattive © <a href="https://www.openstreetmap.org/copyright">contributori OpenStreetMap</a>.</span>
      {beta && <span>Versione beta, non indicizzata.</span>}
    </div>
  </div>
</footer>
<style>
  .site-footer { padding: 60px 0 38px; background: var(--grey); border-top: 1.5px solid var(--bd); color: var(--muted); font-size: 16px; }
  .fg { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .about { grid-column: 1 / -1; }
  .logo { display: inline-flex; gap: 0.45em; font: 800 18px/1 var(--display); letter-spacing: -0.04em; color: var(--ink); text-decoration: none; }
  .logo b { color: var(--brand); }
  .about p { max-width: 34ch; margin: 14px 0 0; }
  h2 { margin: 0 0 16px; font: 800 12px/1 var(--body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
  ul { display: grid; gap: 2px; list-style: none; padding: 0; margin: 0; }
  li a { display: inline-block; min-height: 36px; padding: 8px 0; color: var(--muted); text-decoration: none; }
  li a:hover { color: var(--brand-d); text-decoration: underline; text-decoration-color: var(--or); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .about a:not(.logo), .fb a { color: var(--ink); }
  .fb { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--line-2); font-size: 15px; color: var(--faint); }
  .fb a { color: var(--muted); }
  @media (min-width: 45.01rem) {
    .site-footer { margin-top: 0; }
  }
  @media (min-width: 68.76rem) {
    .fg { grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
    .about { grid-column: auto; }
  }
</style>
