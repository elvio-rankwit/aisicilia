---
import { formatDate } from '../lib/data';
import { hostOf } from './helpers';
interface Props { urls: string[]; verified: Date; what: 'scheda' | 'evento'; level?: 2 | 3; claimed?: Date }
const { urls, verified, what, level = 2, claimed } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
// Testo del link: host + percorso abbreviato, così fonti dello stesso dominio si distinguono.
const labelOf = (u: string): string => {
  try {
    const url = new URL(u);
    const host = url.hostname.replace(/^www\./, '');
    if (host === 'startup.registroimprese.it') return 'Registro startup innovative (estrazione 19/10/2026)';
    const path = url.pathname.replace(/\/+$/, '');
    const full = path ? host + path : host;
    return full.length > 48 ? full.slice(0, 47) + '…' : full;
  } catch { return hostOf(u); }
};
---
<aside class="source-box" aria-labelledby="fonte-titolo">
  <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
  <H id="fonte-titolo">Fonte e ultima verifica</H>
  <p>Ultima verifica: <time datetime={verified.toISOString().slice(0, 10)}>{formatDate(verified)}</time>. {what === 'scheda' ? 'Le informazioni di questa scheda sono state riscritte da noi a partire dalle fonti qui sotto.' : 'Date, luogo e prezzo vanno controllati sul sito dell’organizzatore prima di partire.'}</p>
  {claimed && <p class="claimed">Dati confermati dall’azienda il <time datetime={claimed.toISOString().slice(0, 10)}>{formatDate(claimed)}</time>.</p>}
  <ul>
    {[...new Set(urls)].map((u) => <li><a class="ext" href={u} rel="noopener">{labelOf(u)}</a></li>)}
  </ul>
  <p>Qualcosa non torna? <a href="/metodologia/">Come verifichiamo i dati</a>.</p>
</aside>
<style>
  .source-box { position: relative; max-width: var(--measure); margin-block: var(--space-6); padding: 24px 26px 20px calc(26px + 2.75rem); background: var(--card); border: 1.5px solid var(--bd); border-radius: var(--r-lg); box-shadow: 6px 6px 0 var(--grey-2); }
  .ico { position: absolute; left: 24px; top: 24px; width: 1.75rem; height: 1.75rem; color: var(--teal); }
  .source-box :global(h2), .source-box :global(h3) { margin: 0 0 10px; font-family: var(--display); font-size: 17px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; }
  p, ul { margin: 0 0 12px; font-size: 15.5px; color: var(--muted); }
  ul { padding-left: 1.25rem; }
  li { margin-bottom: 4px; }
  time { font-weight: 700; color: var(--teal); }
  .source-box > :last-child { margin-bottom: 0; }
  .claimed { font-weight: 700; color: var(--teal); }
</style>
