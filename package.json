{
  "name": "aisicilia",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/with-lock.mjs \"astro build --force && pagefind --site dist\"",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/with-lock.mjs node scripts/validate/run.mjs",
    "lhci": "lhci autorun",
    "lhci:desktop": "LHCI_PRESET=desktop lhci autorun",
    "dev:fixtures": "USE_FIXTURES=1 astro dev",
    "build:fixtures": "node scripts/with-lock.mjs \"USE_FIXTURES=1 astro build\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/preact": "^6.1.0",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "preact": "^11.0.1",
    "satori": "^0.63.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
