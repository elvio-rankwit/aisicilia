# beta = noindex ovunque, robots Disallow: /, niente sitemap. production = indicizzabile.
PUBLIC_SITE_MODE=beta
# URL canonico del sito. In beta su Cloudflare Pages puoi lasciare il dominio finale (le pagine sono noindex).
PUBLIC_SITE_URL=https://aisicilia.it
# Endpoint dei form esterni (Tally o Formspree). Vuoto = il form mostra un avviso e un link email.
PUBLIC_FORM_SEGNALA_URL=
PUBLIC_FORM_RIMOZIONE_URL=
PUBLIC_FORM_CONTATTI_URL=
# Solo sviluppo: 1 = carica le fixture fittizie di src/fixtures/ al posto dei dati reali. MAI in produzione.
USE_FIXTURES=0
